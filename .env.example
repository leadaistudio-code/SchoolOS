# ---------- Core ----------
NODE_ENV=development
APP_NAME=MyCampusView
# Root domain used for tenant subdomain resolution (school1.<ROOT_DOMAIN>)
APP_ROOT_DOMAIN=lvh.me:3000
APP_URL=http://lvh.me:3000

# ---------- Database ----------
DATABASE_URL=postgresql://mycampusview:mycampusview@localhost:5433/mycampusview?schema=public
# Opt-in Postgres RLS: apply prisma/rls.sql, use a non-owner DB role, then:
# DATABASE_RLS=true
DATABASE_RLS=false

# ---------- Auth ----------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=720
PASSWORD_MIN_LENGTH=10

# ---------- Cache / Queue (Redis-compatible) ----------
REDIS_URL=redis://localhost:6380

# ---------- Object storage (S3-compatible) ----------
STORAGE_DRIVER=local            # local | s3 (use s3 for Railway Bucket)
STORAGE_LOCAL_DIR=./uploads
# Railway: Connect Bucket → SchoolOS (app service) → Style "AWS SDK (Generic)" injects AWS_*
# (AWS_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY). Those map automatically. Or set S3_* yourself:
S3_ENDPOINT=                    # e.g. https://storage.railway.app
S3_REGION=auto
S3_BUCKET=                      # Railway BUCKET (unique name with hash), not display name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false       # false for new Railway buckets (virtual-hosted); true only if Credentials says path-style
MAX_UPLOAD_MB=15

# ---------- Providers (all abstracted; driver=log works with no vendor) ----------
EMAIL_DRIVER=log                # log | smtp | ses | resend
EMAIL_FROM="MyCampusView <no-reply@example.com>"
SMTP_URL=

SMS_DRIVER=log                  # log | msg91 | twilio
SMS_SENDER_ID=

WHATSAPP_DRIVER=log             # log | meta_cloud | gupshup

PAYMENT_DRIVER=mock             # mock | razorpay | stripe | cashfree
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

MAPS_DRIVER=none                # none | google | mapbox
MAPS_API_KEY=

# The in-app school assistant. Off until a driver and key are set; the launcher
# does not render and the API route returns 503 rather than pretending.
#
#   AI_DRIVER=openai     AI_API_KEY=sk-...        AI_MODEL=gpt-4.1
#   AI_DRIVER=anthropic  AI_API_KEY=sk-ant-...    AI_MODEL=claude-opus-5
#
# The assistant behaves identically either way: same tools, same permissions,
# same draft-then-approve flow. See docs/ASSISTANT.md.
AI_DRIVER=none                  # none | anthropic | openai
AI_API_KEY=
AI_MODEL=                       # optional; per-driver default if blank
AI_BASE_URL=                    # optional; Azure OpenAI or an OpenAI-compatible gateway
AI_EFFORT=medium                # low | medium | high - anthropic only

# Web Push (optional). Without these, the offline shell still works; the
# "Enable app alerts" button only registers a browser subscription when the
# public key is set. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---------- Ops ----------
RATE_LIMIT_DRIVER=memory        # memory | redis — use redis with REDIS_URL for multi-instance
LOG_LEVEL=info
ALERT_WEBHOOK_URL=              # Slack/Discord webhook for npm run health:watch
HEALTH_URL=http://127.0.0.1:3000/api/health
