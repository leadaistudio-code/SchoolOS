# ---------- Core ----------
NODE_ENV=development
APP_NAME=MyCampusView
# Root domain used for tenant subdomain resolution (school1.<ROOT_DOMAIN>)
APP_ROOT_DOMAIN=lvh.me:3000
APP_URL=http://lvh.me:3000

# ---------- Database ----------
DATABASE_URL=postgresql://mycampusview:mycampusview@localhost:5433/mycampusview?schema=public
# Opt-in Postgres RLS: apply prisma/rls.sql, use a non-owner DB role, then:
# DATABASE_RLS=true
DATABASE_RLS=false

# ---------- Auth ----------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=720
PASSWORD_MIN_LENGTH=10

# ---------- Cache / Queue (Redis-compatible) ----------
REDIS_URL=redis://localhost:6380

# ---------- Object storage (S3-compatible) ----------
STORAGE_DRIVER=local            # local | s3 (use s3 for Railway Bucket)
STORAGE_LOCAL_DIR=./uploads
# Railway: Connect Bucket → SchoolOS (app service) → Style "AWS SDK (Generic)" injects AWS_*
# (AWS_ENDPOINT_URL, AWS_S3_BUCKET_NAME, AWS_DEFAULT_REGION, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY). Those map automatically. Or set S3_* yourself:
S3_ENDPOINT=                    # e.g. https://storage.railway.app
S3_REGION=auto
S3_BUCKET=                      # Railway BUCKET (unique name with hash), not display name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false       # false for new Railway buckets (virtual-hosted); true only if Credentials says path-style
MAX_UPLOAD_MB=15

# ---------- Providers (all abstracted; driver=log works with no vendor) ----------
# Set EMAIL_DRIVER to anything but `log` and point SMTP_URL at a transactional
# provider. Every one of them speaks SMTP, so `smtp`, `ses` and `resend` all
# use the same transport - the value is a label, the URL is what matters.
#
# Until this is configured, password reset links are written to the log and
# never delivered, and /forgot-password falls back to raising a support ticket.
#
#   Hostinger smtps://contact%40mycampusview.com:xxxxxxxx@smtp.hostinger.com:465
#   Resend    smtp://resend:re_xxxxxxxx@smtp.resend.com:587
#   Brevo     smtp://you@school.com:xkeysib-xxxx@smtp-relay.brevo.com:587
#   ZeptoMail smtp://emailapikey:xxxxxxxx@smtp.zeptomail.in:587
#   SES       smtp://AKIAxxxx:xxxxxxxx@email-ap-south-1.amazonaws.com:587
#
# Percent-encode any @ / + in the username and password (@ = %40, / = %2F,
# + = %2B). `smtps://` means implicit TLS and defaults to port 465; `smtp://`
# means STARTTLS and defaults to 587. Hostinger accepts either - 465 is the
# one their help pages give.
#
# Verify your sending domain (SPF + DKIM) with the provider, or the mail is
# delivered to spam, which is indistinguishable from not sending it. Hostinger
# adds both records for you when the domain's DNS is with them.
#
# EMAIL_FROM must be the mailbox you authenticated as, or an alias of it.
# Hostinger rejects a From address it does not own.
EMAIL_DRIVER=log                # log | smtp | ses | resend
EMAIL_FROM="MyCampusView <no-reply@example.com>"
SMTP_URL=

# Where a demo request from the website is emailed. Defaults to the address
# published on the site (CONTACT.sales in src/content/site/company.ts); set it
# only to send enquiries somewhere else, such as on staging.
SALES_INBOX=

SMS_DRIVER=log                  # log | msg91 | twilio
SMS_SENDER_ID=

# WhatsApp is the primary channel for self-service password reset: a parent's
# mobile number is the contact detail a school actually keeps current.
#
# Meta requires a pre-approved template in the AUTHENTICATION category for
# one-time codes - free-form text is rejected outside a 24-hour customer
# window, which a password reset never has. Create it in WhatsApp Manager with
# a single body variable {{1}} for the code. If the template carries a
# copy-code button (Meta adds one by default), leave WHATSAPP_OTP_COPY_BUTTON
# true; omitting the button parameter makes Meta reject the whole send.
#
# Until this is configured, /forgot-password falls back to raising a support
# ticket for the platform team.
WHATSAPP_DRIVER=log             # log | meta_cloud | gupshup
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=       # the number's id in WhatsApp Manager, not the number
WHATSAPP_ACCESS_TOKEN=          # permanent system-user token, not a 24h test token
WHATSAPP_OTP_TEMPLATE=password_reset_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
WHATSAPP_OTP_COPY_BUTTON=true

# --- Option A: Gupshup (a BSP - they own the Meta relationship, you don't) ---
# WHATSAPP_DRIVER=gupshup
# WHATSAPP_OTP_TEMPLATE=<template ID from the Gupshup Templates tab, a UUID>
# GUPSHUP_API_KEY=
# GUPSHUP_APP_NAME=leadaistudio          # the app name in the Gupshup dashboard
# GUPSHUP_SOURCE_NUMBER=918585999679     # your registered sender, digits only
# GUPSHUP_API_URL=https://api.gupshup.io/wa/api/v1/template/msg
#
# Note WHATSAPP_OTP_TEMPLATE holds Gupshup's template *ID* here, not Meta's
# template name - the same variable carries a different kind of value
# depending on the driver. WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_OTP_COPY_BUTTON are Meta-only and ignored by this driver.

# Applied when somebody types a local number. School records hold E.164
# (+919842115933); parents type ten digits.
DEFAULT_COUNTRY_CODE=+91

PAYMENT_DRIVER=mock             # mock | razorpay | stripe | cashfree
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

MAPS_DRIVER=none                # none | google | mapbox
MAPS_API_KEY=

# The in-app school assistant. Off until a driver and key are set; the launcher
# does not render and the API route returns 503 rather than pretending.
#
#   AI_DRIVER=openai     AI_API_KEY=sk-...        AI_MODEL=gpt-4.1
#   AI_DRIVER=anthropic  AI_API_KEY=sk-ant-...    AI_MODEL=claude-opus-5
#
# The assistant behaves identically either way: same tools, same permissions,
# same draft-then-approve flow. See docs/ASSISTANT.md.
AI_DRIVER=none                  # none | anthropic | openai
AI_API_KEY=
AI_MODEL=                       # optional; per-driver default if blank
AI_BASE_URL=                    # optional; Azure OpenAI or an OpenAI-compatible gateway
AI_EFFORT=medium                # low | medium | high - anthropic only

# Web Push (optional). Without these, the offline shell still works; the
# "Enable app alerts" button only registers a browser subscription when the
# public key is set. Generate a pair with `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---------- Ops ----------
RATE_LIMIT_DRIVER=memory        # memory | redis — use redis with REDIS_URL for multi-instance
LOG_LEVEL=info
ALERT_WEBHOOK_URL=              # Slack/Discord webhook for npm run health:watch
HEALTH_URL=http://127.0.0.1:3000/api/health
