model CmsBlock {
  id        String  @id @default(cuid())
  tenantId  String
  pageId    String
  kind      String
  heading   String?
  body      String?
  mediaUrl  String?
  data      Json?
  sortOrder Int     @default(0)

  page CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([tenantId, pageId, sortOrder])
}

model CmsPost {
  id          String    @id @default(cuid())
  tenantId    String
  slug        String
  title       String
  excerpt     String?
  body        String
  coverUrl    String?
  category    String    @default("NEWS")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

