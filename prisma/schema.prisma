// MyCampusView — multi-tenant School Management & ERP SaaS
// Tenancy model: shared database / shared schema with a `tenantId` discriminator
// on every tenant-scoped table, enforced by a Prisma client extension
// (src/server/db/tenant-client.ts) and defended in depth by Postgres RLS
// (prisma/migrations/*_rls/migration.sql).

generator client {
  provider      = "prisma-client-js"
  // The build machine and the runtime are different Linux distributions on
  // most serverless hosts: Netlify builds on Debian and runs the functions on
  // Amazon Linux. Without the second target the client builds cleanly and then
  // fails on the first query in production, looking for an engine that was
  // never downloaded.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// SAAS CONTROL PLANE  (not tenant-scoped)
// ===========================================================================

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  ARCHIVED
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

model Plan {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  tier        PlanTier
  description String?
  priceMinor  Int          @default(0) // in minor units (paise)
  currency    String       @default("INR")
  cycle       BillingCycle @default(YEARLY)
  trialDays   Int          @default(14)
  isPublic    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]
}

// A feature entitlement is either a boolean flag or a numeric limit.
// Limits are NEVER hardcoded in application code — they are read from here.
model PlanEntitlement {
  id         String  @id @default(cuid())
  planId     String
  featureKey String // e.g. "module.transport", "limit.students", "limit.storage_mb"
  enabled    Boolean @default(true)
  limitValue Int? // null = unlimited
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([featureKey])
}

model Tenant {
  id         String       @id @default(cuid())
  slug       String       @unique // used for <slug>.rootdomain
  name       String
  status     TenantStatus @default(TRIAL)
  timezone   String       @default("Asia/Kolkata")
  locale     String       @default("en-IN")
  currency   String       @default("INR")
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  archivedAt DateTime?

  school         School?
  domains        TenantDomain[]
  subscription   Subscription?
  overrides      TenantEntitlementOverride[]
  usageMetrics   UsageMetric[]
  supportTickets SupportTicket[]

  @@index([status])
}

model TenantDomain {
  id          String   @id @default(cuid())
  tenantId    String
  host        String   @unique // school1.schoolos.app  |  erp.school.com
  isPrimary   Boolean  @default(false)
  verified    Boolean  @default(false)
  verifyToken String?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Subscription {
  id           String       @id @default(cuid())
  tenantId     String       @unique
  planId       String
  status       TenantStatus @default(TRIAL)
  cycle        BillingCycle @default(YEARLY)
  currentStart DateTime     @default(now())
  currentEnd   DateTime
  trialEndsAt  DateTime?
  cancelAtEnd  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]
}

model SubscriptionInvoice {
  id             String       @id @default(cuid())
  subscriptionId String
  number         String       @unique
  amountMinor    Int
  currency       String       @default("INR")
  status         String       @default("DUE") // DUE | PAID | VOID
  periodStart    DateTime?    @db.Date
  periodEnd      DateTime?    @db.Date
  notes          String?
  dueAt          DateTime
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
}

// Per-tenant override of a plan entitlement (sales-negotiated limits).
model TenantEntitlementOverride {
  id         String   @id @default(cuid())
  tenantId   String
  featureKey String
  enabled    Boolean?
  limitValue Int?
  note       String?
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
}

model UsageMetric {
  id       String   @id @default(cuid())
  tenantId String
  key      String // students.active | storage.bytes | sms.sent | api.requests
  value    BigInt   @default(0)
  periodOn DateTime @db.Date
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key, periodOn])
  @@index([key, periodOn])
}

model SupportTicket {
  id         String                 @id @default(cuid())
  tenantId   String
  subject    String
  body       String
  category   String?
  priority   String                 @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  status     String                 @default("OPEN") // OPEN | PENDING | RESOLVED | CLOSED
  openedById String?
  assigneeId String?
  resolvedAt DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   SupportTicketMessage[]

  @@index([tenantId, status])
  @@index([assigneeId])
}

model SupportTicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorId   String?
  authorKind String        @default("TENANT") // PLATFORM | TENANT
  body       String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ===========================================================================
// SCHOOL PROFILE, BRANDING & CONFIGURATION  (tenant-scoped, 1 per tenant)
// ===========================================================================

model School {
  id        String  @id @default(cuid())
  tenantId  String  @unique
  code      String // school code, e.g. DIS-2024
  name      String
  legalName String?
  email     String?
  phone     String?
  website   String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String  @default("India")
  postalCode   String?

  // Geofence for staff attendance
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int    @default(150)

  // Tax
  taxNumber  String? // GSTIN
  taxPercent Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding Branding?
}

model Branding {
  id       String @id @default(cuid())
  tenantId String @unique
  schoolId String @unique

  logoUrl      String?
  darkLogoUrl  String?
  faviconUrl   String?
  // Theme engine: colors are stored, emitted as CSS custom properties at runtime.
  primaryHex   String  @default("#E41F07")
  secondaryHex String  @default("#0A0C0C")
  accentHex    String  @default("#FFA201")
  radius       String  @default("8px")

  loginHeadline String?
  loginSubtext  String?
  loginImageUrl String?

  /// Full-width letterhead header image used on printed documents.
  letterheadHeaderUrl String?
  /// Full-width letterhead footer image used on printed documents.
  letterheadFooterUrl String?

  pdfHeaderHtml String?
  pdfFooterHtml String?
  footerText    String?
  signatureUrl  String?

  pwaName      String?
  pwaShortName String?
  pwaThemeHex  String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

// Generic namespaced settings bag (email/sms/whatsapp/payment/module toggles…)
// Secrets are stored encrypted at rest via src/server/crypto.ts and never
// leave the server.
model Setting {
  id        String   @id @default(cuid())
  tenantId  String
  namespace String // "email" | "sms" | "payment" | "attendance" | "modules" ...
  key       String
  value     Json
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, namespace, key])
  @@index([tenantId, namespace])
}

// ===========================================================================
// IDENTITY, RBAC, SESSIONS
// ===========================================================================

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  // null tenantId == platform user (SUPER_ADMIN). Everyone else is tenant-bound.
  tenantId     String?
  email        String?
  phone        String?
  passwordHash String?
  firstName    String
  lastName     String
  /// Optional display name / alias shown in the app shell (topbar, menus).
  /// When null, firstName + lastName are used.
  displayName  String?
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  isSuperAdmin Boolean    @default(false)

  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  mustChangePassword    Boolean   @default(false)
  // Set when an administrator issues a temporary password over the phone or
  // counter. Such a password is read aloud and often written down, so it is
  // given a deadline rather than living until somebody happens to use it.
  tempPasswordExpiresAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  roles                 UserRole[]
  sessions              Session[]
  tokens                VerificationToken[]
  loginEvents           LoginEvent[]
  notifications         Notification[]
  markedExamAttendance  ExamAttendance[]    @relation("ExamAttendanceMarker")
  staff                 Staff?
  student               Student?
  parent                Parent?
  sentMessages          Message[]           @relation("MessageSender")
  pushSubscriptions     PushSubscription[]
  crmSchoolsOwned       CrmSchool[]         @relation("CrmSchoolOwner")
  crmSchoolsCreated     CrmSchool[]         @relation("CrmSchoolCreatedBy")
  crmOpportunitiesOwned CrmOpportunity[]    @relation("CrmOpportunityOwner")
  crmFollowUpsAssigned  CrmFollowUp[]       @relation("CrmFollowUpAssignee")
  crmTasksOwned         CrmTask[]           @relation("CrmTaskOwner")
  crmMeetingsCreated    CrmMeeting[]        @relation("CrmMeetingCreatedBy")
  crmVisitsCreated      CrmVisit[]          @relation("CrmVisitCreatedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
}

model Role {
  id          String   @id @default(cuid())
  // null tenantId == built-in system role available to every tenant
  tenantId    String?
  key         String // SCHOOL_ADMIN, TEACHER, custom_sports_head…
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Permission {
  id     String           @id @default(cuid())
  key    String           @unique // students.view, fees.collect …
  module String
  action String
  label  String
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  tenantId         String?
  tokenHash        String    @unique // sha256 of the opaque cookie value
  ip               String?
  userAgent        String?
  device           String?
  // Set when a SUPER_ADMIN is impersonating a tenant user.
  impersonatedById String?
  createdAt        DateTime  @default(now())
  lastSeenAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum TokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
  INVITE
  OTP_LOGIN
  // A one-time code sent to a phone to prove control of it before a reset.
  OTP_RESET
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  // The opaque handle the client holds. For OTP_RESET this identifies the
  // challenge; the code itself lives in codeHash.
  tokenHash String       @unique
  // HMAC of the one-time code for OTP_RESET, keyed with AUTH_SECRET so a
  // database leak alone does not reveal a six-digit code.
  codeHash  String?
  // Wrong guesses so far. A six-digit code is only safe because this is
  // capped — the short expiry alone would not make brute force impractical.
  attempts  Int          @default(0)
  // WHATSAPP | SMS | EMAIL, recorded so a failed delivery can be traced.
  channel   String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  tenantId  String?
  email     String?
  success   Boolean
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  actorLabel String?
  action     String // student.create, fee.refund, permission.change …
  module     String
  entityType String?
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, module, createdAt])
  @@index([entityType, entityId])
}

// ===========================================================================
// ACADEMIC STRUCTURE
// ===========================================================================

model AcademicSession {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes               ClassLevel[]
  enrollments           Enrollment[]
  feeStructures         FeeStructure[]
  studentFeeOptions     StudentFeeOption[]
  studentFeeAssignments StudentFeeAssignment[]
  exams                 Exam[]
  curricula             Curriculum[]
  assessments           Assessment[]
  feedbackCampaigns     FeedbackCampaign[]

  @@unique([tenantId, name])
  @@index([tenantId, isCurrent])
}

model ClassLevel {
  id        String    @id @default(cuid())
  tenantId  String
  sessionId String
  name      String
  numeric   Int
  stream    String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  session               AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sections              Section[]
  subjects              ClassSubject[]
  enrollments           Enrollment[]
  feeStructures         FeeStructure[]
  examClasses           ExamClass[]
  timetableSlots        TimetableSlot[]
  homework              Homework[]
  classwork             Classwork[]
  noticeTargets         NoticeTarget[]
  assessmentAssignments AssessmentAssignment[]

  @@unique([tenantId, sessionId, name])
  @@index([tenantId, sessionId])
}

model Section {
  id             String    @id @default(cuid())
  tenantId       String
  classLevelId   String
  name           String
  capacity       Int       @default(40)
  roomName       String?
  classTeacherId String?
  deletedAt      DateTime?

  classLevel            ClassLevel             @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  classTeacher          Staff?                 @relation("SectionClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  enrollments           Enrollment[]
  timetableSlots        TimetableSlot[]
  homework              Homework[]
  classwork             Classwork[]
  assessments           Assessment[]
  assessmentAssignments AssessmentAssignment[]
  subjects              SectionSubject[]
  substitutions         Substitution[]
  cctvCameras           CctvCamera[]

  @@unique([tenantId, classLevelId, name])
  @@index([tenantId])
}

model Subject {
  id         String    @id @default(cuid())
  tenantId   String
  code       String
  name       String
  isElective Boolean   @default(false)
  deletedAt  DateTime?

  classes             ClassSubject[]
  feedbackAssignments FeedbackAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ClassSubject {
  id             String  @id @default(cuid())
  tenantId       String
  classLevelId   String
  subjectId      String
  teacherId      String?
  /// Timetable generator: lessons a week for each section taking this subject.
  periodsPerWeek Int?
  /// Timetable generator: most lessons of this subject in one section on one day.
  maxPerDay      Int?
  /// Timetable generator: lessons come in back-to-back pairs (labs, practicals).
  doublePeriod   Boolean @default(false)

  classLevel                ClassLevel                 @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  subject                   Subject                    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher                   Staff?                     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  timetable                 TimetableSlot[]
  homework                  Homework[]
  classwork                 Classwork[]
  examSubjects              ExamSubject[]
  curricula                 Curriculum[]
  questions                 Question[]
  textbooks                 Textbook[]
  assessments               Assessment[]
  teacherRefreshAssessments TeacherRefreshAssessment[]
  sections                  SectionSubject[]
  substitutions             Substitution[]

  @@unique([tenantId, classLevelId, subjectId])
  @@index([tenantId, teacherId])
}

/// Which sections of a class take a given class-subject.
///
/// ClassSubject alone means "this class studies the subject". SectionSubject
/// narrows that to specific sections (electives, stream splits). When a
/// ClassSubject has no SectionSubject rows, every section of the class takes
/// it — that keeps existing schools working until they map electives.
model SectionSubject {
  id             String @id @default(cuid())
  tenantId       String
  sectionId      String
  classSubjectId String

  section      Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sectionId, classSubjectId])
  @@index([tenantId, classSubjectId])
  @@index([tenantId, sectionId])
}

// ===========================================================================
// PEOPLE - STUDENTS, PARENTS, STAFF
// ===========================================================================

/// ---------------------------------------------------------------------------
/// Curriculum
///
/// The syllabus, as structure rather than prose. `Classwork.topic` records what
/// a teacher covered on a day as free text, which is right for a lesson log and
/// useless for anything that has to reason about coverage: it cannot answer
/// "which topics are in chapter 2", so it cannot scope a question paper either.
///
/// One curriculum per class-subject per session, because the same subject in
/// the same class changes between years and last year's paper must still resolve
/// to the syllabus it was set from.
/// ---------------------------------------------------------------------------

enum BloomLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

model Curriculum {
  id             String    @id @default(cuid())
  tenantId       String
  sessionId      String
  classSubjectId String
  /// Free-text label, e.g. "CBSE Science VIII". Falls back to the subject name.
  title          String?
  /// CBSE, ICSE, IB, state board - recorded, not validated against a list.
  board          String?
  description    String?
  /// Draft curricula are invisible to paper generation, so a half-entered
  /// syllabus cannot silently narrow what a question may be set from.
  isPublished    Boolean   @default(false)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject    @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  chapters     Chapter[]

  @@unique([tenantId, sessionId, classSubjectId])
  @@index([tenantId, sessionId, isPublished])
}

model Chapter {
  id           String    @id @default(cuid())
  tenantId     String
  curriculumId String
  name         String
  /// What the school calls it - "Ch 1", "Unit II". Display only.
  code         String?
  /// Manual ordering. Deliberately not unique: reordering a list would
  /// otherwise need a temporary value to dodge the constraint mid-swap.
  position     Int       @default(0)
  /// Planned teaching periods, used later to weight coverage.
  periods      Int?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  topics     Topic[]

  @@index([tenantId, curriculumId, position])
}

model Topic {
  id        String    @id @default(cuid())
  tenantId  String
  chapterId String
  name      String
  position  Int       @default(0)
  /// A few sentences of substance. This is what grounds AI generation: a topic
  /// called "Photosynthesis" tells a model nothing a paper can be set from,
  /// and the summary is what stops it inventing scope of its own.
  summary   String?
  /// Share of the paper this topic should carry, when the school sets one.
  weightage Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  chapter                  Chapter                   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  outcomes                 LearningOutcome[]
  questions                QuestionTopic[]
  teacherKnowledgeProfiles TeacherKnowledgeProfile[]

  @@index([tenantId, chapterId, position])
}

model LearningOutcome {
  id         String      @id @default(cuid())
  tenantId   String
  topicId    String
  statement  String
  bloomLevel BloomLevel?
  position   Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([tenantId, topicId, position])
}

/// ---------------------------------------------------------------------------
/// Question bank
///
/// A question belongs to a class-subject rather than to a curriculum, so it
/// survives the syllabus being revised for a new session: the topics it is
/// tagged with move, the question does not have to be re-entered. Tagging is
/// many-to-many because a case study or an application question legitimately
/// spans topics, and a paper set from "chapters 1-3" has to find it.
/// ---------------------------------------------------------------------------

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
  MATCH
  ONE_WORD
  VERY_SHORT
  SHORT
  LONG
  DESCRIPTIVE
  CASE_STUDY
  ASSERTION_REASON
  NUMERICAL
  DIAGRAM
  COMPREHENSION
  PRACTICAL
  HOTS
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Where a question came from. Kept because a teacher reviewing a paper judges
/// an AI draft differently from a colleague's question, and because "how much
/// of our bank is generated" is a question the school will eventually ask.
enum QuestionOrigin {
  MANUAL
  AI
  IMPORTED
}

/// AI output lands as DRAFT and cannot reach a paper until a teacher approves
/// it. That is the whole of the review requirement, enforced in one column
/// rather than in each screen that might forget.
enum QuestionStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum TextbookStatus {
  PROCESSING
  READY
  FAILED
}

/// A school-provided, licensed source used to ground AI question generation.
/// The original remains private in tenant-scoped object storage; extracted
/// pages make source selection and page-level citations deterministic.
model Textbook {
  id              String         @id @default(cuid())
  tenantId        String
  classSubjectId  String
  board           String
  publisher       String?
  title           String
  fileName        String
  storageKey      String
  mimeType        String
  sizeBytes       Int
  checksum        String
  status          TextbookStatus @default(PROCESSING)
  pageCount       Int            @default(0)
  extractionError String?
  uploadedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  classSubject ClassSubject   @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  pages        TextbookPage[]
  questions    Question[]

  @@unique([tenantId, classSubjectId, checksum])
  @@index([tenantId, classSubjectId, status])
}

model TextbookPage {
  id         String @id @default(cuid())
  tenantId   String
  textbookId String
  pageNumber Int
  text       String

  textbook Textbook @relation(fields: [textbookId], references: [id], onDelete: Cascade)

  @@unique([tenantId, textbookId, pageNumber])
  @@index([tenantId, textbookId])
}

model Question {
  id              String             @id @default(cuid())
  tenantId        String
  classSubjectId  String
  textbookId      String?
  sourcePageStart Int?
  sourcePageEnd   Int?
  text            String
  type            QuestionType
  difficulty      QuestionDifficulty @default(MEDIUM)
  marks           Float              @default(1)
  bloomLevel      BloomLevel?
  /// The answer, in the form the type calls for: the correct option for an
  /// MCQ, a worked solution for a numerical, the expected points for anything
  /// descriptive. Deliberately one nullable column rather than a shape per
  /// type, because the marking scheme is prose in every case that matters.
  solution        String?
  /// Why the answer is the answer. Shown when a result is released, never
  /// before.
  explanation     String?
  /// Textbook, paper or page this came from, when a teacher records it.
  source          String?
  origin          QuestionOrigin     @default(MANUAL)
  status          QuestionStatus     @default(APPROVED)
  /// School-wide visibility. Off by default: a teacher's own drafts are their
  /// own until they choose otherwise.
  isShared        Boolean            @default(false)
  /// Normalised-text hash, for exact duplicate detection. Near-duplicates are
  /// found by token overlap against candidates narrowed by topic — that needs
  /// no extension and no vector store, and at bank scale it is fast enough.
  fingerprint     String
  createdById     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  classSubject            ClassSubject             @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  textbook                Textbook?                @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  options                 QuestionOption[]
  topics                  QuestionTopic[]
  placements              AssessmentQuestion[]
  usages                  QuestionUsage[]
  teacherRefreshQuestions TeacherRefreshQuestion[]

  @@index([tenantId, classSubjectId, status])
  @@index([tenantId, textbookId])
  @@index([tenantId, fingerprint])
  @@index([tenantId, type, difficulty])
  @@index([tenantId, createdById])
}

model QuestionOption {
  id         String  @id @default(cuid())
  tenantId   String
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  /// The right-hand side of a match-the-following pair. Null for every other
  /// type, which is why this is one model rather than two.
  matchWith  String?
  position   Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([tenantId, questionId, position])
}

model QuestionTopic {
  id         String @id @default(cuid())
  tenantId   String
  questionId String
  topicId    String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([tenantId, questionId, topicId])
  @@index([tenantId, topicId])
}

/// ---------------------------------------------------------------------------
/// Assessments
///
/// A question paper. Separate from `Exam`, which is the formal examination a
/// report card is computed from: a fortnightly practice test is an assessment
/// and has no business in a report card, while a half-yearly is both. Keeping
/// them apart means the daily instrument can be used freely without every
/// result reaching a parent, and `AssessmentResult` is promoted into `Mark`
/// deliberately rather than by default.
/// ---------------------------------------------------------------------------

enum AssessmentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ASSIGNED
  CLOSED
}

/// The test types from the spec, as rows rather than an enum, because a school
/// has to be able to add its own. The seeded ones are `isSystem` and cannot be
/// deleted, only deactivated.
model AssessmentType {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  /// Suggested defaults a teacher can override, so picking "Unit Test" fills
  /// the form rather than leaving it blank.
  marks     Float?
  minutes   Int?
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  assessments Assessment[]

  @@unique([tenantId, key])
  @@index([tenantId, isActive, position])
}

/// Header and print settings. Multiple per school — a unit test slip and a
/// board-style paper are not laid out the same way.
model PaperTemplate {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  /// Overrides the school name in the header when a campus prints its own.
  headingOverride     String?
  showLogo            Boolean   @default(true)
  showStudentName     Boolean   @default(true)
  showRollNumber      Boolean   @default(true)
  showDate            Boolean   @default(true)
  generalInstructions String?
  footerNote          String?
  isDefault           Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  assessments Assessment[]

  @@index([tenantId, isDefault])
}

model Assessment {
  id               String           @id @default(cuid())
  tenantId         String
  sessionId        String
  classSubjectId   String
  /// Narrows the paper to one section when it is set for one; null means the
  /// whole class level.
  sectionId        String?
  assessmentTypeId String
  templateId       String?
  title            String
  /// What the teacher declared. Compared against the sum of placed questions,
  /// so the builder can say the paper does not add up rather than silently
  /// printing a 38-mark paper titled 40.
  totalMarks       Float
  durationMinutes  Int
  instructions     String?
  /// Free-text notes printed at the head of the answer key.
  answerKeyNotes   String?
  status           AssessmentStatus @default(DRAFT)
  /// Set A / Set B / Set C. Null on the original; variants point at it.
  parentId         String?
  setLabel         String?
  createdById      String?
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  session      AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject           @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  section      Section?               @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  type         AssessmentType         @relation(fields: [assessmentTypeId], references: [id])
  template     PaperTemplate?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  parent       Assessment?            @relation("AssessmentSets", fields: [parentId], references: [id], onDelete: Cascade)
  sets         Assessment[]           @relation("AssessmentSets")
  sections     AssessmentSection[]
  questions    AssessmentQuestion[]
  usages       QuestionUsage[]
  assignments  AssessmentAssignment[]

  @@index([tenantId, classSubjectId, status])
  @@index([tenantId, sessionId, createdAt])
  @@index([tenantId, createdById])
}

model AssessmentSection {
  id           String  @id @default(cuid())
  tenantId     String
  assessmentId String
  /// "Section A". Printed as given.
  title        String
  instructions String?
  position     Int     @default(0)

  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@index([tenantId, assessmentId, position])
}

/// A question placed in a paper.
///
/// The text, options and answer are copied here at placement rather than read
/// through to `Question` every time. A paper that has been sat is a record: if
/// a colleague later corrects a typo in the bank, or archives the question
/// entirely, last term's paper and the answers marked against it must not
/// change underneath. The bank link is kept for analytics, and it is nullable
/// for exactly that reason.
model AssessmentQuestion {
  id                 String             @id @default(cuid())
  tenantId           String
  assessmentId       String
  sectionId          String
  questionId         String?
  position           Int                @default(0)
  /// Marks for this placement. Defaults from the bank question and can differ:
  /// the same question is worth more in a long-answer section.
  marks              Float
  textSnapshot       String
  /// Options as placed: [{ text, isCorrect, matchWith }]. Json because the
  /// shape varies by type and this copy is never queried, only rendered.
  optionsSnapshot    Json?
  /// The answer key entry. Seeded from the bank question's solution, then
  /// editable per paper without touching the bank.
  answerSnapshot     String?
  typeSnapshot       QuestionType
  difficultySnapshot QuestionDifficulty
  createdAt          DateTime           @default(now())

  assessment Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  section    AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question   Question?         @relation(fields: [questionId], references: [id], onDelete: SetNull)
  answers    StudentAnswer[]

  @@index([tenantId, assessmentId, position])
  @@index([tenantId, sectionId, position])
  @@index([tenantId, questionId])
}

/// When a question was last used, and where.
///
/// Written on approval, not on placement: a question dragged into a draft and
/// then removed was never asked. This is what stops the same five questions
/// appearing in every fortnightly test.
model QuestionUsage {
  id           String   @id @default(cuid())
  tenantId     String
  questionId   String
  assessmentId String
  usedOn       DateTime @default(now())

  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, questionId, assessmentId])
  @@index([tenantId, questionId, usedOn])
}

/// ---------------------------------------------------------------------------
/// Sitting a paper
///
/// An assignment is a paper given to a group at a time. The attempt is one
/// student's sitting of it, and the answers hang off the attempt rather than
/// off the student, so a second attempt is a second row rather than an
/// overwrite of the first.
/// ---------------------------------------------------------------------------

enum AssessmentMode {
  /// Sat on paper. The application records who it was set for and marks are
  /// entered later; there is no attempt to run.
  OFFLINE
  /// Answered in the student portal, timed.
  ONLINE
  /// Answered in the portal, untimed and unmarked — revision.
  PRACTICE
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model AssessmentAssignment {
  id              String         @id @default(cuid())
  tenantId        String
  assessmentId    String
  /// Who it is set for. A section is the common case; a class level with no
  /// section means every section of that class.
  classLevelId    String?
  sectionId       String?
  mode            AssessmentMode @default(OFFLINE)
  opensAt         DateTime
  dueAt           DateTime
  /// Overrides the paper's own duration for this sitting, when a class is
  /// given extra time.
  minutesOverride Int?

  /// Online options. Defaults are the conservative reading of each: the paper
  /// as written, in order, with the student able to go back.
  shuffleQuestions   Boolean @default(false)
  shuffleOptions     Boolean @default(false)
  onePerScreen       Boolean @default(false)
  allowBack          Boolean @default(true)
  /// Submits whatever is saved when the timer runs out, rather than losing it.
  autoSubmit         Boolean @default(true)
  attemptLimit       Int     @default(1)
  /// Practice tests can show the score immediately; a real test should not,
  /// because a result is released by a teacher and not by a clock.
  showResultOnSubmit Boolean @default(false)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  assessment   Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel?         @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  section      Section?            @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  attempts     AssessmentAttempt[]
  answerSheets AnswerSheet[]

  @@index([tenantId, assessmentId])
  @@index([tenantId, sectionId, opensAt])
  @@index([tenantId, dueAt])
}

model AssessmentAttempt {
  id             String        @id @default(cuid())
  tenantId       String
  assignmentId   String
  studentId      String
  attemptNumber  Int           @default(1)
  status         AttemptStatus @default(IN_PROGRESS)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  /// True when the timer submitted it rather than the student. Kept because a
  /// run of auto-submissions in one section usually means the paper was too
  /// long, not that the class was slow.
  autoSubmitted  Boolean       @default(false)
  /// Objective marks, computed at submission. Null until then, and it stays
  /// partial until a teacher marks the written answers.
  objectiveScore Float?
  /// Everything, once evaluation is finished.
  totalScore     Float?
  evaluatedById  String?
  evaluatedAt    DateTime?
  /// Released to the student. A score existing and a student being allowed to
  /// see it are different facts.
  publishedAt    DateTime?
  teacherComment String?

  assignment   AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers      StudentAnswer[]
  answerSheets AnswerSheet[]

  @@unique([tenantId, assignmentId, studentId, attemptNumber])
  @@index([tenantId, studentId, status])
  @@index([tenantId, assignmentId, status])
}

model StudentAnswer {
  id                   String    @id @default(cuid())
  tenantId             String
  attemptId            String
  assessmentQuestionId String
  /// Written answers, and the typed answer for one-word and fill-in-the-blank.
  responseText         String?
  /// Chosen option indexes, against the placement's option snapshot. Indexes
  /// rather than ids because the snapshot is the paper as sat, and shuffling
  /// is presentation only — the server always scores against the original
  /// order.
  selectedIndexes      Json?
  /// Set at submission for objective types, by a teacher for the rest.
  isCorrect            Boolean?
  marksAwarded         Float?
  teacherComment       String?
  evaluatedById        String?
  evaluatedAt          DateTime?
  updatedAt            DateTime  @updatedAt

  attempt            AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentQuestion AssessmentQuestion @relation(fields: [assessmentQuestionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, attemptId, assessmentQuestionId])
  @@index([tenantId, attemptId])
}

// ---------------------------------------------------------------------------
// Academic Intelligence — handwritten answer sheets + AI evaluation jobs
//
// Extends Assessments. Does not replace StudentAnswer / manual marking.
// AI suggests marks; teachers approve before publish (default).
// ---------------------------------------------------------------------------

enum AnswerSheetStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum EvaluationJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

enum EvaluatedAnswerReviewStatus {
  PENDING
  APPROVED
  OVERRIDDEN
  FLAGGED
}

/// Scanned or photographed answer sheet for offline / handwritten evaluation.
model AnswerSheet {
  id           String            @id @default(cuid())
  tenantId     String
  assignmentId String
  studentId    String
  /// Optional link once an attempt row exists (offline papers may create one later).
  attemptId    String?
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  pageCount    Int               @default(1)
  status       AnswerSheetStatus @default(UPLOADED)
  uploadedById String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  assignment AssessmentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempt    AssessmentAttempt?   @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  jobs       EvaluationJob[]

  @@index([tenantId, assignmentId, status])
  @@index([tenantId, studentId])
  @@index([tenantId, attemptId])
}

/// Async OCR / vision evaluation against the paper answer key + rubric.
model EvaluationJob {
  id            String              @id @default(cuid())
  tenantId      String
  answerSheetId String
  /// Links to the durable `Job` row when queued on the worker.
  workerJobId   String?
  status        EvaluationJobStatus @default(QUEUED)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3)
  lastError     String?
  startedAt     DateTime?
  finishedAt    DateTime?
  /// Provider-agnostic summary: pages, tokens, model id (no secrets).
  usage         Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  answerSheet AnswerSheet       @relation(fields: [answerSheetId], references: [id], onDelete: Cascade)
  answers     EvaluatedAnswer[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, answerSheetId])
  @@index([workerJobId])
}

/// One AI-extracted / scored answer. Teacher review required before marks land on StudentAnswer.
model EvaluatedAnswer {
  id                   String                      @id @default(cuid())
  tenantId             String
  evaluationJobId      String
  assessmentQuestionId String?
  questionNumber       Int?
  extractedText        String?
  ocrConfidence        Float?
  evaluationConfidence Float?
  suggestedMarks       Float?
  maxMarks             Float?
  feedback             String?
  rubricNotes          Json?
  needsReview          Boolean                     @default(false)
  reviewStatus         EvaluatedAnswerReviewStatus @default(PENDING)
  teacherMarks         Float?
  teacherFeedback      String?
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  evaluationJob EvaluationJob @relation(fields: [evaluationJobId], references: [id], onDelete: Cascade)

  @@index([tenantId, evaluationJobId])
  @@index([tenantId, reviewStatus, needsReview])
}

/// School-level AI usage for cost control (no provider secrets).
model AiUsageEvent {
  id                 String   @id @default(cuid())
  tenantId           String
  kind               String
  /// e.g. evaluation.pages, question.generate
  units              Int      @default(1)
  model              String?
  estimatedCostMinor Int?
  meta               Json?
  createdById        String?
  createdAt          DateTime @default(now())

  @@index([tenantId, kind, createdAt])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  ALUMNI
  TRANSFERRED
  WITHDRAWN
  SUSPENDED
}

model Student {
  id                 String    @id @default(cuid())
  tenantId           String
  userId             String?   @unique
  admissionNo        String
  firstName          String
  lastName           String
  photoUrl           String?
  dateOfBirth        DateTime? @db.Date
  gender             Gender?
  bloodGroup         String?
  nationality        String?
  religion           String?
  category           String?
  motherTongue       String?
  caste              String?
  aadhaarNo          String?
  birthPlace         String?
  identificationMark String?
  disability         String?
  house              String?
  whatsappPhone      String?

  admissionDate  DateTime? @db.Date
  previousSchool String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?

  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  allergies             String?

  status    StudentStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  user                 User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments          Enrollment[]
  guardians            StudentGuardian[]
  attendance           StudentAttendance[]
  leaveRequests        LeaveRequest[]
  invoices             FeeInvoice[]
  storeSales           StoreSale[]
  payments             FeePayment[]
  concessions          FeeConcession[]
  feeOptions           StudentFeeOption[]
  feeAssignments       StudentFeeAssignment[]
  feeCredits           StudentFeeCredit[]
  feeAdjustments       FeeAdjustment[]
  feeReminderLogs      FeeReminderLog[]
  marks                Mark[]
  examAttendance       ExamAttendance[]
  results              Result[]
  certificates         Certificate[]
  transferCertificates TransferCertificate[]
  admitCards           AdmitCard[]
  homeworkSubmissions  HomeworkSubmission[]
  libraryLoans         LibraryLoan[]
  transport            TransportAssignment[]
  boardingLogs         TransportBoardingLog[]
  documents            Document[]
  sportsTeams          SportsTeamMember[]
  disciplineRecords    DisciplineRecord[]
  assessmentAttempts   AssessmentAttempt[]
  answerSheets         AnswerSheet[]
  feedbackAssignments  FeedbackAssignment[]
  feedbackResponses    FeedbackResponse[]
  receivedFeedback     TeacherStudentFeedback[]
  gatePasses           GatePass[]
  parentQueries        ParentQuery[]

  @@unique([tenantId, admissionNo])
  @@index([tenantId, status])
  @@index([tenantId, lastName, firstName])
}

// Placement of a student in a class/section for one academic session.
// Historical sessions stay intact - promotion creates a new Enrollment row.
model Enrollment {
  id           String    @id @default(cuid())
  tenantId     String
  studentId    String
  sessionId    String
  classLevelId String
  sectionId    String
  rollNumber   Int?
  isCurrent    Boolean   @default(true)
  joinedOn     DateTime  @default(now())
  leftOn       DateTime?

  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session    AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  section    Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, sessionId])
  @@unique([tenantId, sectionId, sessionId, rollNumber])
  @@index([tenantId, sectionId, isCurrent])
  @@index([tenantId, classLevelId, isCurrent])
}

model Parent {
  id           String    @id @default(cuid())
  tenantId     String
  userId       String?   @unique
  firstName    String
  lastName     String
  phone        String?
  email        String?
  occupation   String?
  annualIncome String?
  photoUrl     String?
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  children            StudentGuardian[]
  documents           Document[]
  feedbackAssignments FeedbackAssignment[]
  feedbackResponses   FeedbackResponse[]
  gatePasses          GatePass[]
  queries             ParentQuery[]

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, phone])
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

// One parent account to many children. This is what lets a parent switch
// between children without a separate login per child.
model StudentGuardian {
  id                 String           @id @default(cuid())
  tenantId           String
  studentId          String
  parentId           String
  relation           GuardianRelation @default(GUARDIAN)
  isPrimary          Boolean          @default(false)
  canPickup          Boolean          @default(true)
  isEmergencyContact Boolean          @default(false)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, studentId, parentId])
  @@index([tenantId, parentId])
}

enum StaffType {
  TEACHING
  ADMIN
  SUPPORT
  DRIVER
  LIBRARIAN
  ACCOUNTANT
  OTHER
}

model Staff {
  id                         String    @id @default(cuid())
  tenantId                   String
  userId                     String?   @unique
  employeeCode               String
  firstName                  String
  lastName                   String
  photoUrl                   String?
  staffType                  StaffType @default(TEACHING)
  designation                String?
  department                 String?
  qualification              String?
  experienceYears            Float?
  dateOfBirth                DateTime? @db.Date
  gender                     Gender?
  phone                      String?
  email                      String?
  joinedOn                   DateTime? @db.Date
  leftOn                     DateTime?
  salaryMinor                Int?
  bankAccount                String?
  addressLine1               String?
  city                       String?
  state                      String?
  postalCode                 String?
  /// When true, attendance uses this staff member's own check-in/out window (guest / part-time).
  customAttendanceHours      Boolean   @default(false)
  /// Check-in start — minutes from midnight in the school timezone. Null = school open.
  attendanceStartMinutes     Int?
  /// Check-out end — minutes from midnight. Null = school close.
  attendanceEndMinutes       Int?
  /// Late after this minute-of-day. Null = attendanceStartMinutes (or school staff late setting).
  attendanceLateAfterMinutes Int?
  /// Timetable generator: most lessons this teacher takes in one day.
  timetableMaxPerDay         Int?
  /// Timetable generator: slots the teacher cannot take, as "day:periodId".
  timetableUnavailable       String[]  @default([])
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  deletedAt                  DateTime?

  user                      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  classSubjects             ClassSubject[]
  classTeacherOf            Section[]                  @relation("SectionClassTeacher")
  attendance                StaffAttendance[]
  leaveRequests             LeaveRequest[]
  timetableSlots            TimetableSlot[]
  homework                  Homework[]
  classwork                 Classwork[]
  documents                 Document[]
  drivenBuses               Bus[]
  trips                     BusTrip[]
  markedStudentAttendance   StudentAttendance[]        @relation("AttendanceMarker")
  salaryStructures          StaffSalaryStructure[]
  payslips                  StaffPayslip[]
  appraisals                StaffAppraisal[]           @relation("AppraisalSubject")
  appraisalsReviewed        StaffAppraisal[]           @relation("AppraisalReviewer")
  feedbackTargets           FeedbackAssignment[]       @relation("FeedbackTargetStaff")
  teacherStudentFeedback    TeacherStudentFeedback[]   @relation("TeacherStudentFeedbackAuthor")
  assignedFeedbackActions   FeedbackActionItem[]       @relation("FeedbackActionAssignee")
  teacherKnowledgeProfiles  TeacherKnowledgeProfile[]
  teacherRefreshAssessments TeacherRefreshAssessment[]
  teacherRefreshAttempts    TeacherRefreshAttempt[]
  absences                  Substitution[]             @relation("SubstitutionAbsent")
  coverDuties               Substitution[]             @relation("SubstitutionCover")

  @@unique([tenantId, employeeCode])
  @@index([tenantId, staffType])
  @@index([tenantId, lastName, firstName])
}

model DisciplineRecord {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  occurredOn   DateTime @db.Date
  category     String
  severity     String   @default("MINOR")
  notes        String
  actionTaken  String?
  recordedById String?
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
}

// ===========================================================================
// ATTENDANCE (STUDENT + STAFF, INCLUDING GEOFENCED STAFF CHECK-IN)
// ===========================================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
  HOLIDAY
}

model StudentAttendance {
  id           String           @id @default(cuid())
  tenantId     String
  studentId    String
  sectionId    String
  sessionId    String
  onDate       DateTime         @db.Date
  status       AttendanceStatus
  minutesLate  Int?
  remarks      String?
  /// How the day was marked. Existing rows stay MANUAL when source is null-defaulted.
  source       AttendanceSource @default(MANUAL)
  /// First / last biometric punch of the day (UTC). Null for register-only marks.
  firstPunchAt DateTime?
  lastPunchAt  DateTime?
  markedById   String?
  markedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy Staff?  @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, onDate])
  @@index([tenantId, sectionId, onDate])
  @@index([tenantId, onDate, status])
}

enum AttendanceSource {
  MANUAL
  GEOFENCE
  BIOMETRIC
  IMPORT
}

model StaffAttendance {
  id         String           @id @default(cuid())
  tenantId   String
  staffId    String
  onDate     DateTime         @db.Date
  status     AttendanceStatus
  checkInAt  DateTime?
  checkOutAt DateTime?
  source     AttendanceSource @default(MANUAL)

  // Geofence evidence captured at check-in time.
  latitude         Float?
  longitude        Float?
  accuracyM        Float?
  distanceM        Float?
  insideGeofence   Boolean?
  deviceInfo       String?
  // Basic anti-spoofing signals reported by the client and verified server-side.
  mockLocationFlag Boolean  @default(false)

  // Admin correction leaves the original record intact and is always audited.
  overriddenById String?
  overrideReason String?

  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, onDate])
  @@index([tenantId, onDate, status])
}

// ===========================================================================
// LEAVE MANAGEMENT
// ===========================================================================

enum LeaveApplicantType {
  STUDENT
  STAFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id         String             @id @default(cuid())
  tenantId   String
  name       String
  appliesTo  LeaveApplicantType
  maxPerYear Int?
  isPaid     Boolean            @default(true)
  deletedAt  DateTime?

  requests LeaveRequest[]

  @@unique([tenantId, name, appliesTo])
  @@index([tenantId])
}

model LeaveRequest {
  id            String             @id @default(cuid())
  tenantId      String
  applicantType LeaveApplicantType
  studentId     String?
  staffId       String?
  leaveTypeId   String?
  fromDate      DateTime           @db.Date
  toDate        DateTime           @db.Date
  reason        String
  attachmentUrl String?
  status        LeaveStatus        @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  appliedById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  student   Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff     Staff?     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  leaveType LeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, fromDate])
  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
}

// ===========================================================================
// FINANCE - FEE STRUCTURES, INVOICES, PAYMENTS, RECEIPTS, LEDGER
// All money is stored as integer minor units (paise) to avoid float drift.
// ===========================================================================

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  TERM_WISE
  ANNUAL
  CUSTOM
}

enum FeeStructureStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FeeAssignmentStatus {
  ACTIVE
  ENDED
}

enum FeeCreditEntryType {
  CREDIT
  APPLIED
  REFUND
  ADJUSTMENT
  REVERSAL
}

enum FeeAdjustmentType {
  CHARGE
  CREDIT
  REVERSAL
}

enum FeeReminderOffsetType {
  BEFORE_DUE
  ON_DUE
  AFTER_DUE
}

model FeeHead {
  id           String       @id @default(cuid())
  tenantId     String
  code         String
  name         String
  frequency    FeeFrequency @default(ANNUAL)
  isRefundable Boolean      @default(false)
  isDeposit    Boolean      @default(false)
  sortOrder    Int          @default(0)
  /// Optional billing window: no charges for this head fall outside it.
  startsOn     DateTime?    @db.Date
  endsOn       DateTime?    @db.Date
  deletedAt    DateTime?

  items            FeeStructureItem[]
  lines            FeeInvoiceLine[]
  feeOptions       StudentFeeOption[]
  installmentLines FeeInstallmentLine[]
  transportRates   TransportFeeRate[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model FeeStructure {
  id           String             @id @default(cuid())
  tenantId     String
  sessionId    String
  classLevelId String?
  name         String
  description  String?
  isActive     Boolean            @default(true)
  status       FeeStructureStatus @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  session      AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  classLevel   ClassLevel?            @relation(fields: [classLevelId], references: [id], onDelete: SetNull)
  items        FeeStructureItem[]
  invoices     FeeInvoice[]
  installments FeeInstallment[]
  assignments  StudentFeeAssignment[]

  @@unique([tenantId, sessionId, name])
  @@index([tenantId, sessionId, isActive])
}

model FeeStructureItem {
  id              String        @id @default(cuid())
  tenantId        String
  structureId     String
  feeHeadId       String
  amountMinor     Int
  /// Amount shown per occurrence in the setup wizard. Legacy rows leave this null.
  unitAmountMinor Int?
  /// Optional item-level frequency. Legacy rows continue using FeeHead.frequency.
  frequency       FeeFrequency?
  /// Number of occurrences used to derive the annual amount.
  occurrenceCount Int?
  dueDayOfMonth   Int?
  dueOn           DateTime?     @db.Date
  /// When true, only students with a matching StudentFeeOption are billed this line.
  isOptional      Boolean       @default(false)

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeHead   FeeHead      @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([tenantId, structureId, feeHeadId])
  @@index([tenantId])
}

/// A published structure's due schedule. One installment becomes one invoice per assignment.
model FeeInstallment {
  id          String    @id @default(cuid())
  tenantId    String
  structureId String
  name        String
  /// Invoice generation date. Null = the 1st of the due month.
  issueOn     DateTime? @db.Date
  dueOn       DateTime  @db.Date
  amountMinor Int
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  structure FeeStructure         @relation(fields: [structureId], references: [id], onDelete: Cascade)
  lines     FeeInstallmentLine[]

  @@unique([tenantId, structureId, name])
  @@index([tenantId, structureId, dueOn])
}

model FeeInstallmentLine {
  id            String @id @default(cuid())
  tenantId      String
  installmentId String
  feeHeadId     String
  label         String
  amountMinor   Int

  installment FeeInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  feeHead     FeeHead        @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([tenantId, installmentId, feeHeadId])
  @@index([tenantId, feeHeadId])
}

/// Explicit assignment of a fee group/structure to a student.
model StudentFeeAssignment {
  id               String              @id @default(cuid())
  tenantId         String
  studentId        String
  sessionId        String
  structureId      String
  status           FeeAssignmentStatus @default(ACTIVE)
  assignedAt       DateTime            @default(now())
  endedAt          DateTime?
  assignedById     String?
  /// First billing month generated automatically by the daily finance job.
  /// Null keeps invoice creation manual.
  autoGenerateFrom DateTime?           @db.Date
  /// Fee heads included in future automatic monthly invoices.
  autoFeeHeadIds   String[]            @default([])
  notes            String?

  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  structure FeeStructure    @relation(fields: [structureId], references: [id], onDelete: Restrict)

  @@unique([tenantId, studentId, sessionId, structureId])
  @@index([tenantId, sessionId, status])
  @@index([tenantId, studentId, status])
  @@index([tenantId, autoGenerateFrom, status])
}

/// Opt-in for optional fee lines (e.g. Computer Science ₹500 add-on).
model StudentFeeOption {
  id        String   @id @default(cuid())
  tenantId  String
  studentId String
  sessionId String
  feeHeadId String
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feeHead FeeHead         @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([tenantId, studentId, sessionId, feeHeadId])
  @@index([tenantId, sessionId, feeHeadId, active])
}

enum ConcessionKind {
  PERCENT
  FLAT
}

model FeeConcession {
  id           String         @id @default(cuid())
  tenantId     String
  studentId    String
  name         String
  kind         ConcessionKind @default(PERCENT)
  value        Int // percent (0-100) or flat amount in minor units
  feeHeadId    String?
  reason       String?
  approvedById String?
  validFrom    DateTime?      @db.Date
  validTo      DateTime?      @db.Date
  createdAt    DateTime       @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
}

// ===========================================================================
// FEEDBACK & EXPERIENCE
// Templates, campaigns, assignments and answers stay separate so reporting is
// queryable and anonymous respondent identity never has to leave the server.
// ===========================================================================

enum FeedbackAudience {
  STUDENT
  PARENT
  TEACHER
}

enum FeedbackTarget {
  TEACHER
  SCHOOL
  STUDENT
  PTM
}

enum FeedbackQuestionType {
  RATING_5
  RATING_10
  YES_NO
  MULTIPLE_CHOICE
  CHECKBOX
  EMOJI
  NPS
  SHORT_TEXT
  LONG_TEXT
  DROPDOWN
}

enum FeedbackCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  PAUSED
  ARCHIVED
}

enum FeedbackAssignmentStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum FeedbackModerationStatus {
  SUBMITTED
  APPROVED
  FLAGGED
  UNDER_REVIEW
  HIDDEN
  ESCALATED
  RESOLVED
}

enum FeedbackConcernStatus {
  NEW
  UNDER_REVIEW
  FOLLOW_UP_REQUIRED
  RESOLVED
  CLOSED
}

enum FeedbackActionStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum FeedbackPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FeedbackVisibility {
  TEACHER_ONLY
  STUDENT
  PARENT
  STUDENT_AND_PARENT
  COORDINATOR
  ADMINISTRATION
}

model FeedbackTemplate {
  id                  String           @id @default(cuid())
  tenantId            String
  name                String
  audience            FeedbackAudience
  target              FeedbackTarget
  isAnonymousToTarget Boolean          @default(true)
  minimumResponses    Int              @default(5)
  classMinNumeric     Int?
  classMaxNumeric     Int?
  isActive            Boolean          @default(true)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  questions   FeedbackQuestion[]
  campaigns   FeedbackCampaign[]
  assignments FeedbackAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, audience, target, isActive])
}

model FeedbackQuestion {
  id          String               @id @default(cuid())
  tenantId    String
  templateId  String
  label       String
  description String?
  type        FeedbackQuestionType @default(RATING_5)
  category    String?
  required    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  choices     Json?
  isConcern   Boolean              @default(false)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())

  template FeedbackTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  FeedbackAnswer[]

  @@index([tenantId, templateId, sortOrder])
}

model FeedbackCampaign {
  id                  String                 @id @default(cuid())
  tenantId            String
  templateId          String
  sessionId           String?
  name                String
  audience            FeedbackAudience
  target              FeedbackTarget
  status              FeedbackCampaignStatus @default(DRAFT)
  frequency           String                 @default("FORTNIGHTLY")
  startsAt            DateTime?
  endsAt              DateTime?
  classLevelIds       Json?
  sectionIds          Json?
  subjectIds          Json?
  teacherIds          Json?
  studentIds          Json?
  isAnonymousToTarget Boolean                @default(true)
  minimumResponses    Int                    @default(5)
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  template    FeedbackTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  session     AcademicSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  assignments FeedbackAssignment[]

  @@index([tenantId, status, startsAt])
  @@index([tenantId, templateId])
}

model FeedbackAssignment {
  id            String                   @id @default(cuid())
  tenantId      String
  campaignId    String
  templateId    String
  studentId     String?
  parentId      String?
  targetStaffId String?
  subjectId     String?
  classLevelId  String?
  sectionId     String?
  periodKey     String
  status        FeedbackAssignmentStatus @default(PENDING)
  dueAt         DateTime?
  submittedAt   DateTime?
  createdAt     DateTime                 @default(now())

  campaign    FeedbackCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  template    FeedbackTemplate   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  student     Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent      Parent?            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  targetStaff Staff?             @relation("FeedbackTargetStaff", fields: [targetStaffId], references: [id], onDelete: SetNull)
  subject     Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  responses   FeedbackResponse[]

  @@unique([tenantId, campaignId, studentId, targetStaffId, subjectId, periodKey])
  @@index([tenantId, studentId, status])
  @@index([tenantId, parentId, status])
  @@index([tenantId, targetStaffId, status])
}

model FeedbackResponse {
  id               String   @id @default(cuid())
  tenantId         String
  assignmentId     String
  respondentUserId String
  studentId        String?
  parentId         String?
  submittedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  assignment FeedbackAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  parent     Parent?              @relation(fields: [parentId], references: [id], onDelete: SetNull)
  answers    FeedbackAnswer[]
  concern    FeedbackConcern?
  actions    FeedbackActionItem[]

  @@unique([tenantId, assignmentId])
  @@index([tenantId, submittedAt])
}

model FeedbackAnswer {
  id         String   @id @default(cuid())
  tenantId   String
  responseId String
  questionId String
  rating     Int?
  value      String?
  createdAt  DateTime @default(now())

  response   FeedbackResponse    @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question   FeedbackQuestion    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  moderation FeedbackModeration?

  @@unique([tenantId, responseId, questionId])
  @@index([tenantId, questionId, rating])
}

model FeedbackConcern {
  id         String                @id @default(cuid())
  tenantId   String
  responseId String                @unique
  detail     String
  status     FeedbackConcernStatus @default(NEW)
  ownerId    String?
  resolvedAt DateTime?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  response FeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

model FeedbackModeration {
  id         String                   @id @default(cuid())
  tenantId   String
  answerId   String                   @unique
  status     FeedbackModerationStatus @default(SUBMITTED)
  flagReason String?
  note       String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  answer FeedbackAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
}

model FeedbackActionItem {
  id              String               @id @default(cuid())
  tenantId        String
  responseId      String?
  concernId       String?
  title           String
  description     String?
  category        String?
  assigneeStaffId String?
  priority        FeedbackPriority     @default(MEDIUM)
  status          FeedbackActionStatus @default(OPEN)
  dueAt           DateTime?
  internalNotes   String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  response FeedbackResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  assignee Staff?            @relation("FeedbackActionAssignee", fields: [assigneeStaffId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, dueAt])
  @@index([tenantId, assigneeStaffId, status])
}

model TeacherStudentFeedback {
  id            String             @id @default(cuid())
  tenantId      String
  studentId     String
  teacherId     String
  subjectId     String?
  classLevelId  String?
  sectionId     String?
  tags          Json?
  performance   String?
  participation String?
  homework      String?
  behaviour     String?
  strengths     String?
  improvement   String?
  actions       String?
  comment       String?
  visibility    FeedbackVisibility @default(STUDENT_AND_PARENT)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Staff   @relation("TeacherStudentFeedbackAuthor", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, teacherId, createdAt])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model FeeInvoice {
  id          String        @id @default(cuid())
  tenantId    String
  number      String
  studentId   String
  sessionId   String
  structureId String?
  /// Stable origin for generated installments/transport periods.
  sourceKey   String?
  title       String
  issuedOn    DateTime      @db.Date
  dueOn       DateTime      @db.Date
  status      InvoiceStatus @default(ISSUED)

  subtotalMinor Int @default(0)
  discountMinor Int @default(0)
  taxMinor      Int @default(0)
  lateFeeMinor  Int @default(0)
  totalMinor    Int @default(0)
  paidMinor     Int @default(0)
  // Generated column would be ideal; kept explicit and updated inside the
  // same transaction as every payment so it can be indexed and aggregated.
  balanceMinor  Int @default(0)

  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?

  student           Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  structure         FeeStructure?          @relation(fields: [structureId], references: [id], onDelete: SetNull)
  lines             FeeInvoiceLine[]
  allocations       FeePaymentAllocation[]
  creditEntries     StudentFeeCredit[]
  adjustments       FeeAdjustment[]
  refundAllocations FeeRefundAllocation[]

  @@unique([tenantId, number])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, studentId, status])
  @@index([tenantId, status, dueOn])
  @@index([tenantId, dueOn])
}

model FeeInvoiceLine {
  id            String  @id @default(cuid())
  tenantId      String
  invoiceId     String
  feeHeadId     String?
  label         String
  amountMinor   Int
  discountMinor Int     @default(0)
  taxPercent    Float   @default(0)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  feeHead FeeHead?   @relation(fields: [feeHeadId], references: [id], onDelete: SetNull)

  @@index([tenantId, invoiceId])
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK_TRANSFER
  CARD
  UPI
  NET_BANKING
  WALLET
  ONLINE
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  REVERSED
}

// A payment attempt. Rows are created BEFORE the gateway redirect and only
// move to SUCCESS after server-side verification (webhook or verify call).
// Frontend success callbacks never mutate money state.
model FeePayment {
  id          String        @id @default(cuid())
  tenantId    String
  studentId   String
  amountMinor Int
  currency    String        @default("INR")
  mode        PaymentMode
  status      PaymentStatus @default(INITIATED)

  provider          String? // razorpay | stripe | cashfree | mock | manual
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  providerResponse  Json?

  // Idempotency: a client-supplied key makes retries safe, and the provider
  // payment id is unique so a replayed webhook cannot double-credit.
  idempotencyKey String?

  reference     String? // cheque no / UTR
  // Serial number written on the school's physical receipt book when the
  // cashier issues a paper receipt alongside this one. Free text and not
  // unique: schools commonly run two counters from two books whose numbers
  // overlap. It exists to reconcile paper against system, so it is indexed.
  billBookNo    String?
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  collectedById String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student       Student                @relation(fields: [studentId], references: [id], onDelete: Restrict)
  allocations   FeePaymentAllocation[]
  receipt       FeeReceipt?
  refunds       FeeRefund[]
  events        PaymentEvent[]
  creditEntries StudentFeeCredit[]

  @@unique([tenantId, idempotencyKey])
  @@unique([provider, providerPaymentId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, billBookNo])
}

// One payment can settle several invoices; this is the money ledger.
model FeePaymentAllocation {
  id          String @id @default(cuid())
  tenantId    String
  paymentId   String
  invoiceId   String
  amountMinor Int

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, paymentId, invoiceId])
  @@index([tenantId, invoiceId])
}

// Raw, append-only record of every gateway callback for forensics and replay.
model PaymentEvent {
  id             String    @id @default(cuid())
  tenantId       String?
  paymentId      String?
  provider       String
  eventType      String
  externalId     String?
  signatureValid Boolean   @default(false)
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  payment FeePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@index([tenantId, createdAt])
}

model FeeReceipt {
  id         String    @id @default(cuid())
  tenantId   String
  number     String
  paymentId  String    @unique
  issuedOn   DateTime  @default(now())
  pdfUrl     String?
  emailedAt  DateTime?
  whatsappAt DateTime?

  payment FeePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@index([tenantId, issuedOn])
}

model FeeRefund {
  id               String        @id @default(cuid())
  tenantId         String
  paymentId        String
  amountMinor      Int
  reason           String
  status           PaymentStatus @default(PENDING)
  provider         String?
  providerRefundId String?
  approvedById     String?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?

  payment     FeePayment            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  allocations FeeRefundAllocation[]

  @@index([tenantId, status])
}

/// Immutable distribution of a refund back across the original invoices.
model FeeRefundAllocation {
  id          String @id @default(cuid())
  tenantId    String
  refundId    String
  invoiceId   String
  amountMinor Int

  refund  FeeRefund  @relation(fields: [refundId], references: [id], onDelete: Restrict)
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, refundId, invoiceId])
  @@index([tenantId, invoiceId])
}

// Late-fee / penalty rules evaluated by a scheduled job, never ad hoc.
model FeePenaltyRule {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  graceDays Int            @default(0)
  kind      ConcessionKind @default(FLAT)
  value     Int
  perDay    Boolean        @default(false)
  maxMinor  Int?
  isActive  Boolean        @default(true)

  @@unique([tenantId, name])
}

/// Append-only student credit ledger. Positive CREDIT/REFUND/ADJUSTMENT entries add
/// credit; APPLIED/REVERSAL entries consume it. Never overwrite prior entries.
model StudentFeeCredit {
  id          String             @id @default(cuid())
  tenantId    String
  studentId   String
  type        FeeCreditEntryType
  amountMinor Int
  paymentId   String?
  invoiceId   String?
  reference   String?
  notes       String?
  createdById String?
  createdAt   DateTime           @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payment FeePayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, paymentId])
}

/// Manual financial correction. A reversal is a new offsetting row linked to the
/// original adjustment; posted rows are never edited or deleted.
model FeeAdjustment {
  id                   String            @id @default(cuid())
  tenantId             String
  studentId            String
  invoiceId            String?
  type                 FeeAdjustmentType
  amountMinor          Int
  reason               String
  reversedAdjustmentId String?
  createdById          String?
  createdAt            DateTime          @default(now())

  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  invoice FeeInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, studentId, createdAt])
  @@index([tenantId, invoiceId])
  @@index([tenantId, reversedAdjustmentId])
}

model FeeReminderRule {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  offsetType  FeeReminderOffsetType
  offsetDays  Int                   @default(0)
  channels    Json
  templateKey String                @default("fee.due")
  maxSends    Int                   @default(1)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model FeeReminderLog {
  id          String   @id @default(cuid())
  tenantId    String
  studentId   String
  invoiceId   String?
  ruleId      String?
  channels    Json
  amountMinor Int
  sentById    String?
  sentAt      DateTime @default(now())
  slot        Int      @default(0)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ruleId, invoiceId, slot])
  @@index([tenantId, studentId, sentAt])
  @@index([tenantId, invoiceId, sentAt])
  @@index([tenantId, ruleId, sentAt])
}

/// Monthly transport rate read from the existing route/stop assignment.
model TransportFeeRate {
  id            String    @id @default(cuid())
  tenantId      String
  stopId        String
  feeHeadId     String
  amountMinor   Int
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stop    BusStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  feeHead FeeHead @relation(fields: [feeHeadId], references: [id], onDelete: Restrict)

  @@unique([tenantId, stopId, feeHeadId, effectiveFrom])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

enum ExpenseCategory {
  SALARY
  UTILITIES
  MAINTENANCE
  SUPPLIES
  TRANSPORT
  FOOD
  EVENTS
  ADMIN
  ACADEMIC
  OTHER
}

enum ExpensePaymentMode {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

/// School operating expenses — tracked separately from student fee collection.
model SchoolExpense {
  id              String             @id @default(cuid())
  tenantId        String
  title           String
  category        ExpenseCategory    @default(OTHER)
  amountMinor     Int
  expenseDate     DateTime           @db.Date
  paymentMode     ExpensePaymentMode @default(CASH)
  vendor          String?
  referenceNo     String?
  notes           String?
  recordedById    String?
  recordedByLabel String?
  headId          String?
  /// Copied from the head so dashboards and P&L agree without a join.
  nature          ExpenseNature      @default(INDIRECT)
  receiptKey      String?
  receiptName     String?
  receiptMime     String?
  /// Day Book voucher number (EXP-2627-00001); null for expenses recorded before it existed.
  voucherNumber   String?
  /// Client-generated key so a retried or double-clicked submission saves once.
  idempotencyKey  String?
  /// Cash or bank ledger paid from; null = the account mapped to the payment mode.
  cashAccountId   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  head ExpenseHead? @relation(fields: [headId], references: [id], onDelete: SetNull)

  @@unique([tenantId, voucherNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, expenseDate])
  @@index([tenantId, category, expenseDate])
  @@index([tenantId, nature, expenseDate])
  @@index([tenantId, headId])
  @@index([tenantId, deletedAt])
}

/// Direct = cost of delivering teaching; indirect = running the school.
enum ExpenseNature {
  DIRECT
  INDIRECT
}

/// A school-defined expense head (Electricity, Rent, Teaching salary ...).
model ExpenseHead {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  category    ExpenseCategory @default(OTHER)
  nature      ExpenseNature   @default(INDIRECT)
  /// Ledger account the head posts to; each head normally has its own.
  accountId   String?
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  account  LedgerAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  expenses SchoolExpense[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

// ===========================================================================
// EXAMINATION, RESULTS, REPORT CARDS, CERTIFICATES
// ===========================================================================

enum ExamKind {
  WEEKLY
  MONTHLY
  UNIT_TEST
  MID_TERM
  FINAL
  PRACTICAL
  CUSTOM
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  ONGOING
  MARKS_ENTRY
  PUBLISHED
  ARCHIVED
}

enum GradingSystem {
  GRADES
  POINTS
  DESCRIPTIVE
  MARKS_ONLY
}

enum GradingBasis {
  PERCENT
  MARKS
}

model GradingScale {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isDefault   Boolean       @default(false)
  system      GradingSystem @default(GRADES)
  /// MARKS: bands were entered as marks out of `outOf`; minPercent/maxPercent
  /// are always kept in sync so grading code works in percent only.
  basis       GradingBasis  @default(PERCENT)
  outOf       Float?
  /// ALL_PAPERS: pass needs a passing band and every paper at its pass mark.
  /// OVERALL: pass needs only the overall percentage at or above passPercent.
  passRule    String        @default("ALL_PAPERS")
  passPercent Float         @default(33)
  bands       GradeBand[]
  exams       Exam[]

  @@unique([tenantId, name])
}

model GradeBand {
  id         String  @id @default(cuid())
  tenantId   String
  scaleId    String
  grade      String
  minPercent Float
  maxPercent Float
  minMarks   Float?
  maxMarks   Float?
  points     Float?
  remark     String?
  isPass     Boolean @default(true)

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scaleId, grade])
}

model Exam {
  id             String     @id @default(cuid())
  tenantId       String
  sessionId      String
  name           String
  kind           ExamKind   @default(UNIT_TEST)
  status         ExamStatus @default(DRAFT)
  startsOn       DateTime?  @db.Date
  endsOn         DateTime?  @db.Date
  gradingScaleId String?
  weightPercent  Float?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())

  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  gradingScale GradingScale?   @relation(fields: [gradingScaleId], references: [id], onDelete: SetNull)
  classes      ExamClass[]
  subjects     ExamSubject[]
  results      Result[]
  admitCards   AdmitCard[]

  @@unique([tenantId, sessionId, name])
  @@index([tenantId, status])
}

model ExamClass {
  id           String @id @default(cuid())
  tenantId     String
  examId       String
  classLevelId String

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examId, classLevelId])
}

model ExamSubject {
  id               String    @id @default(cuid())
  tenantId         String
  examId           String
  classSubjectId   String
  /// Total for the paper, including the optional internal and oral parts.
  maxMarks         Float     @default(100)
  passMarks        Float     @default(33)
  internalMaxMarks Float?
  oralMaxMarks     Float?
  examDate         DateTime? @db.Date
  startTime        String?
  endTime          String?
  roomName         String?

  /// Marks sheet workflow: teachers submit a sheet, an administrator locks it.
  marksStatus        MarksSheetStatus @default(OPEN)
  marksSubmittedAt   DateTime?
  marksSubmittedById String?
  marksLockedAt      DateTime?
  marksLockedById    String?
  /// Paper closed by an administrator without (complete) marks, e.g. not
  /// conducted. It stays locked and is left out of results and report cards.
  closedWithoutMarks Boolean          @default(false)
  closedReason       String?

  exam         Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  classSubject ClassSubject     @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  marks        Mark[]
  attendance   ExamAttendance[]

  @@unique([tenantId, examId, classSubjectId])
  @@index([tenantId, examDate])
  @@index([tenantId, marksStatus])
}

enum MarksSheetStatus {
  OPEN
  SUBMITTED
  LOCKED
}

enum MarkEntrySource {
  TEACHER_MANUAL
  ADMIN_MANUAL
  CSV_IMPORT
}

model Mark {
  id            String          @id @default(cuid())
  tenantId      String
  examSubjectId String
  studentId     String
  /// Total across written, internal and oral parts.
  marksObtained Float?
  internalMarks Float?
  oralMarks     Float?
  isAbsent      Boolean         @default(false)
  /// Student did not opt for this paper; it is left out of their result.
  notApplicable Boolean         @default(false)
  grade         String?
  remarks       String?
  enteredById   String?
  source        MarkEntrySource @default(ADMIN_MANUAL)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examSubjectId, studentId])
  @@index([tenantId, studentId])
}

enum ExamAttendanceSource {
  BARCODE
  MANUAL
}

/// Paper-level exam attendance. A multi-day exam needs one check-in per paper;
/// marking attendance once at the exam level would incorrectly cover every day.
model ExamAttendance {
  id            String               @id @default(cuid())
  tenantId      String
  examSubjectId String
  studentId     String
  status        AttendanceStatus     @default(PRESENT)
  source        ExamAttendanceSource @default(MANUAL)
  checkedInAt   DateTime?
  markedById    String?
  remarks       String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  examSubject ExamSubject @relation(fields: [examSubjectId], references: [id], onDelete: Cascade)
  student     Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  markedBy    User?       @relation("ExamAttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, examSubjectId, studentId])
  @@index([tenantId, examSubjectId, status])
  @@index([tenantId, studentId])
}

model Result {
  id              String    @id @default(cuid())
  tenantId        String
  examId          String
  studentId       String
  totalMax        Float     @default(0)
  totalObtained   Float     @default(0)
  percentage      Float     @default(0)
  grade           String?
  rankInClass     Int?
  isPass          Boolean   @default(true)
  teacherRemark   String?
  principalRemark String?
  /// Part 2 of the holistic card: { competencies: {name: {score, note}}, coScholastic: {name: {grade, note}} }
  holistic        Json?
  promotionStatus String?
  publishedAt     DateTime?
  reportCardUrl   String?
  computedAt      DateTime  @default(now())

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examId, studentId])
  @@index([tenantId, studentId])
}

enum AdmitCardStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdmitCard {
  id                String          @id @default(cuid())
  tenantId          String
  examId            String
  studentId         String
  number            String
  status            AdmitCardStatus @default(PENDING)
  feeDueMinor       Int             @default(0)
  issuedById        String?
  approvedById      String?
  approvedAt        DateTime?
  rejectedReason    String?
  feeOverrideReason String?
  feeOverrideAt     DateTime?
  verifyToken       String          @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, examId, studentId])
  @@unique([tenantId, number])
  @@index([tenantId, examId, status])
}

model ReportCardTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  isDefault      Boolean  @default(false)
  showAttendance Boolean  @default(true)
  showRank       Boolean  @default(true)
  showRemarks    Boolean  @default(true)
  headerHtml     String?
  footerHtml     String?
  config         Json?
  createdAt      DateTime @default(now())

  @@unique([tenantId, name])
}

model CertificateTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // TRANSFER | BONAFIDE | ACHIEVEMENT | CHARACTER | custom
  name      String
  bodyHtml  String
  // Variables the template may use, e.g. student_name, class, roll_number.
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  certificates Certificate[]

  @@unique([tenantId, key])
}

model Certificate {
  id          String    @id @default(cuid())
  tenantId    String
  templateId  String
  studentId   String
  number      String
  issuedOn    DateTime  @default(now())
  data        Json?
  pdfUrl      String?
  // Public token used by the QR verification endpoint.
  verifyToken String    @unique
  revokedAt   DateTime?
  issuedById  String?

  template CertificateTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  student  Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
}

enum TransferCertificateStatus {
  ISSUED
  CANCELLED
}

/// School leaving / transfer certificate. Issuing marks the student TRANSFERRED
/// and disables their login; cancelling restores both.
model TransferCertificate {
  id              String                    @id @default(cuid())
  tenantId        String
  studentId       String
  number          String
  bookNo          String?
  applicationDate DateTime?                 @db.Date
  issuedOn        DateTime                  @db.Date
  reason          String?
  /// Every printed row of the certificate, as filled in when issued.
  details         Json
  status          TransferCertificateStatus @default(ISSUED)
  previousStatus  StudentStatus             @default(ACTIVE)
  loginDisabled   Boolean                   @default(false)
  issuedById      String?
  issuedByLabel   String?
  cancelledAt     DateTime?
  cancelReason    String?
  cancelledById   String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, number])
  @@index([tenantId, studentId])
  @@index([tenantId, issuedOn])
}

// ===========================================================================
// TEACHING - HOMEWORK, CLASSWORK, TIMETABLE, CALENDAR
// ===========================================================================

model Homework {
  id             String    @id @default(cuid())
  tenantId       String
  classLevelId   String
  sectionId      String?
  classSubjectId String
  teacherId      String
  title          String
  instructions   String?
  assignedOn     DateTime  @db.Date
  dueOn          DateTime  @db.Date
  maxScore       Float?
  isPublished    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  classLevel   ClassLevel           @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  section      Section?             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject         @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher      Staff                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attachments  Attachment[]
  submissions  HomeworkSubmission[]

  @@index([tenantId, sectionId, dueOn])
  @@index([tenantId, teacherId, assignedOn])
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  REVIEWED
  REDO
}

model HomeworkSubmission {
  id             String           @id @default(cuid())
  tenantId       String
  homeworkId     String
  studentId      String
  status         SubmissionStatus @default(PENDING)
  submittedAt    DateTime?
  note           String?
  score          Float?
  teacherComment String?
  reviewedById   String?
  reviewedAt     DateTime?

  homework    Homework     @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student     Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@unique([tenantId, homeworkId, studentId])
  @@index([tenantId, studentId, status])
}

model Classwork {
  id             String    @id @default(cuid())
  tenantId       String
  classLevelId   String
  sectionId      String?
  classSubjectId String
  teacherId      String
  onDate         DateTime  @db.Date
  topic          String
  notes          String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  classLevel   ClassLevel   @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  section      Section?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher      Staff        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([tenantId, sectionId, onDate])
}

model TimetablePeriod {
  id        String  @id @default(cuid())
  tenantId  String
  name      String
  startTime String // HH:mm, school local time
  endTime   String
  sortOrder Int     @default(0)
  isBreak   Boolean @default(false)

  slots         TimetableSlot[]
  substitutions Substitution[]

  @@unique([tenantId, name])
}

model TimetableSlot {
  id             String  @id @default(cuid())
  tenantId       String
  classLevelId   String
  sectionId      String
  periodId       String
  classSubjectId String?
  teacherId      String?
  dayOfWeek      Int // 1 = Monday .. 7 = Sunday
  roomName       String?

  classLevel   ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  section      Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period       TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  classSubject ClassSubject?   @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)
  teacher      Staff?          @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  // A section can hold only one lesson per period per day.
  @@unique([tenantId, sectionId, dayOfWeek, periodId])
  @@index([tenantId, teacherId, dayOfWeek])
}

enum CalendarEventKind {
  HOLIDAY
  EXAM
  PTM
  EVENT
  ACTIVITY
  FUNCTION
  OTHER
}

model CalendarEvent {
  id          String            @id @default(cuid())
  tenantId    String
  title       String
  description String?
  kind        CalendarEventKind @default(EVENT)
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean           @default(true)
  location    String?
  color       String?
  // Empty audience list = visible to everyone in the tenant.
  audience    Json?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, startsAt])
  @@index([tenantId, kind, startsAt])
}

// ===========================================================================
// COMMUNICATION - NOTICES, MESSAGES, NOTIFICATIONS
// ===========================================================================

enum NoticePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Notice {
  id          String         @id @default(cuid())
  tenantId    String
  title       String
  body        String
  priority    NoticePriority @default(NORMAL)
  publishOn   DateTime       @default(now())
  expiresOn   DateTime?
  isPublished Boolean        @default(true)
  pinned      Boolean        @default(false)
  createdById String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  targets     NoticeTarget[]
  attachments Attachment[]

  @@index([tenantId, isPublished, publishOn])
}

enum AudienceKind {
  ALL
  ROLE
  CLASS
  SECTION
  STUDENT
  STAFF
  PARENT
}

model NoticeTarget {
  id           String       @id @default(cuid())
  tenantId     String
  noticeId     String
  kind         AudienceKind
  roleKey      String?
  classLevelId String?
  sectionId    String?
  subjectId    String?

  notice     Notice      @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  classLevel ClassLevel? @relation(fields: [classLevelId], references: [id], onDelete: Cascade)

  @@index([tenantId, noticeId])
}

// ===========================================================================
// TEACHER KNOWLEDGE REFRESH & READINESS
// ===========================================================================

enum TeacherRefreshFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  CUSTOM
}

model TeacherRefreshConfig {
  id                    String                  @id @default(cuid())
  tenantId              String                  @unique
  enabled               Boolean                 @default(false)
  frequency             TeacherRefreshFrequency @default(WEEKLY)
  weeklyQuestionCount   Int                     @default(10)
  monthlyQuestionCount  Int                     @default(25)
  passingThreshold      Float                   @default(70.0) // percentage
  maxAttempts           Int                     @default(2)
  preLectureEnabled     Boolean                 @default(true)
  preLectureCount       Int                     @default(5)
  completionWindowHours Int                     @default(48)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProficiencyLevel {
  STRONG
  GOOD
  REFRESH_RECOMMENDED
  DEVELOPING
}

model TeacherKnowledgeProfile {
  id           String           @id @default(cuid())
  tenantId     String
  teacherId    String
  topicId      String
  proficiency  ProficiencyLevel @default(GOOD)
  lastTestedAt DateTime?
  // Stores historical trend data
  history      Json?

  teacher Staff @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  topic   Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teacherId, topicId])
  @@index([tenantId, teacherId])
}

enum TeacherRefreshType {
  WEEKLY
  MONTHLY
  PRE_LECTURE
  MANUAL
}

enum TeacherRefreshStatus {
  PENDING
  COMPLETED
  OVERDUE
  EXEMPTED
}

model TeacherRefreshAssessment {
  id             String               @id @default(cuid())
  tenantId       String
  teacherId      String
  classSubjectId String
  type           TeacherRefreshType
  status         TeacherRefreshStatus @default(PENDING)
  scheduledAt    DateTime
  dueAt          DateTime
  questionCount  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher      Staff                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSubject ClassSubject             @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  questions    TeacherRefreshQuestion[]
  attempts     TeacherRefreshAttempt[]

  @@index([tenantId, teacherId, status])
  @@index([tenantId, dueAt])
}

model TeacherRefreshQuestion {
  id           String @id @default(cuid())
  tenantId     String
  assessmentId String
  questionId   String
  position     Int    @default(0)

  assessment TeacherRefreshAssessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question                      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers    TeacherRefreshAttemptAnswer[]

  @@unique([tenantId, assessmentId, questionId])
  @@index([tenantId, assessmentId, position])
}

model TeacherRefreshAttempt {
  id           String    @id @default(cuid())
  tenantId     String
  assessmentId String
  teacherId    String
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  score        Float?
  maxScore     Float?

  // Topic-level breakdown of performance during this attempt
  topicBreakdown Json?
  // AI-generated concise refresher notes based on weaknesses
  feedback       Json?

  assessment TeacherRefreshAssessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  teacher    Staff                         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  answers    TeacherRefreshAttemptAnswer[]

  @@index([tenantId, assessmentId])
  @@index([tenantId, teacherId])
}

model TeacherRefreshAttemptAnswer {
  id                String @id @default(cuid())
  tenantId          String
  attemptId         String
  refreshQuestionId String

  // Selected option index or text
  selectedIndexes Json?
  responseText    String?
  isCorrect       Boolean?

  attempt         TeacherRefreshAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  refreshQuestion TeacherRefreshQuestion @relation(fields: [refreshQuestionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, attemptId, refreshQuestionId])
  @@index([tenantId, attemptId])
}

model Conversation {
  id            String   @id @default(cuid())
  tenantId      String
  subject       String?
  kind          String   @default("DIRECT") // DIRECT | GROUP | BROADCAST
  createdById   String?
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([tenantId, lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String
  userId         String
  lastReadAt     DateTime?
  mutedAt        DateTime?
  // Mailbox state is per participant, not per thread: archiving a conversation
  // clears it from your own inbox without touching anyone else's.
  archivedAt     DateTime?
  starredAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, conversationId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, userId, archivedAt])
}

model Message {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@index([tenantId, conversationId, createdAt])
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  tenantId  String?
  eventKey  String // fee.due, attendance.absent, result.published ...
  channel   NotificationChannel
  subject   String?
  body      String
  isActive  Boolean             @default(true)
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, eventKey, channel])
  @@index([eventKey])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  eventKey  String
  title     String
  body      String
  linkUrl   String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([tenantId, userId, readAt])
  @@index([tenantId, createdAt])
}

model NotificationDelivery {
  id                String              @id @default(cuid())
  tenantId          String
  notificationId    String
  channel           NotificationChannel
  status            DeliveryStatus      @default(QUEUED)
  provider          String?
  providerMessageId String?
  attempts          Int                 @default(0)
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, channel])
}

// ===========================================================================
// LIBRARY
// ===========================================================================

model BookCategory {
  id       String @id @default(cuid())
  tenantId String
  name     String
  books    Book[]

  @@unique([tenantId, name])
}

model Book {
  id              String    @id @default(cuid())
  tenantId        String
  categoryId      String?
  title           String
  author          String?
  publisher       String?
  isbn            String?
  edition         String?
  language        String?
  shelfCode       String?
  priceMinor      Int?
  totalCopies     Int       @default(1)
  availableCopies Int       @default(1)
  coverUrl        String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  category BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  copies   BookCopy[]
  loans    LibraryLoan[]

  @@unique([tenantId, isbn])
  @@index([tenantId, title])
}

model BookCopy {
  id          String  @id @default(cuid())
  tenantId    String
  bookId      String
  barcode     String
  condition   String  @default("GOOD")
  isAvailable Boolean @default(true)

  book  Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans LibraryLoan[]

  @@unique([tenantId, barcode])
  @@index([tenantId, bookId, isAvailable])
}

enum LoanStatus {
  ISSUED
  RETURNED
  OVERDUE
  LOST
}

model LibraryLoan {
  id         String     @id @default(cuid())
  tenantId   String
  bookId     String
  copyId     String?
  studentId  String?
  staffId    String?
  issuedOn   DateTime   @default(now())
  dueOn      DateTime   @db.Date
  returnedOn DateTime?
  status     LoanStatus @default(ISSUED)
  fineMinor  Int        @default(0)
  finePaid   Boolean    @default(false)
  issuedById String?
  remarks    String?

  book    Book      @relation(fields: [bookId], references: [id], onDelete: Restrict)
  copy    BookCopy? @relation(fields: [copyId], references: [id], onDelete: SetNull)
  student Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueOn])
  @@index([tenantId, studentId])
}

// ===========================================================================
// INVENTORY / ASSETS
// ===========================================================================

enum AssetCondition {
  NEW
  GOOD
  FAIR
  NEEDS_REPAIR
  DISPOSED
}

model AssetCategory {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  assets   Asset[]

  @@unique([tenantId, name])
}

model Asset {
  id                 String         @id @default(cuid())
  tenantId           String
  categoryId         String?
  assetCode          String
  name               String
  description        String?
  quantity           Int            @default(1)
  purchaseDate       DateTime?      @db.Date
  purchasePriceMinor Int?
  vendorName         String?
  invoiceNo          String?
  location           String?
  assignedToStaffId  String?
  condition          AssetCondition @default(GOOD)
  warrantyEndsOn     DateTime?      @db.Date
  disposedOn         DateTime?      @db.Date
  createdAt          DateTime       @default(now())
  deletedAt          DateTime?

  category AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  history  AssetHistory[]

  @@unique([tenantId, assetCode])
  @@index([tenantId, condition])
}

model AssetHistory {
  id         String   @id @default(cuid())
  tenantId   String
  assetId    String
  action     String // ASSIGNED | RETURNED | MAINTENANCE | DISPOSED | MOVED
  notes      String?
  actorId    String?
  occurredAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([tenantId, assetId, occurredAt])
}

// ===========================================================================
// SCHOOL STORE (sale stock: books, uniforms, stationery …)
// ===========================================================================

enum StoreCategory {
  BOOKS
  STATIONERY
  UNIFORM
  SHOES
  BAGS
  ACCESSORIES
  SPORTS
  OTHER
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
}

enum StoreSaleStatus {
  COMPLETED
  VOIDED
}

/// Quantity is a cache of the movement ledger and only changes with a StockMovement.
model StoreItem {
  id                String        @id @default(cuid())
  tenantId          String
  sku               String
  name              String
  category          StoreCategory @default(OTHER)
  /// Size, colour or class, e.g. "Size 32", "Class 5".
  variant           String?
  unit              String        @default("pcs")
  hsnCode           String?
  barcode           String?
  /// GST included in the selling price.
  taxPercent        Float         @default(0)
  sellingPriceMinor Int
  /// Weighted average cost of units in stock.
  avgCostMinor      Int           @default(0)
  quantity          Int           @default(0)
  reorderLevel      Int           @default(0)
  description       String?
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  movements     StockMovement[]
  saleLines     StoreSaleLine[]
  purchaseLines StorePurchaseLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, category])
  @@index([tenantId, name])
}

model StockMovement {
  id            String            @id @default(cuid())
  tenantId      String
  itemId        String
  type          StockMovementType
  /// Signed: positive adds stock, negative removes it.
  quantity      Int
  unitCostMinor Int               @default(0)
  balanceAfter  Int
  saleId        String?
  purchaseId    String?
  reason        String?
  actorId       String?
  actorLabel    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  item StoreItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, itemId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([tenantId, saleId])
}

/// Stock received (goods receipt). Paid at the time of receipt.
model StorePurchase {
  id             String   @id @default(cuid())
  tenantId       String
  number         String
  vendorName     String
  invoiceNo      String?
  purchaseDate   DateTime @db.Date
  paymentMode    String   @default("CASH")
  totalMinor     Int
  notes          String?
  createdById    String?
  createdByLabel String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines StorePurchaseLine[]

  @@unique([tenantId, number])
  @@index([tenantId, purchaseDate])
}

model StorePurchaseLine {
  id            String @id @default(cuid())
  tenantId      String
  purchaseId    String
  itemId        String
  quantity      Int
  unitCostMinor Int
  amountMinor   Int

  purchase StorePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     StoreItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, purchaseId])
  @@index([tenantId, itemId])
}

model StoreSale {
  id            String          @id @default(cuid())
  tenantId      String
  number        String
  soldAt        DateTime        @default(now())
  studentId     String?
  customerName  String?
  customerPhone String?
  /// Before line discounts, GST included.
  grossMinor    Int
  discountMinor Int             @default(0)
  taxMinor      Int             @default(0)
  totalMinor    Int
  /// Cost of goods sold at weighted average cost.
  costMinor     Int             @default(0)
  paymentMode   String
  paymentRef    String?
  status        StoreSaleStatus @default(COMPLETED)
  voidedAt      DateTime?
  voidReason    String?
  voidedById    String?
  soldById      String?
  soldByLabel   String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  student Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  lines   StoreSaleLine[]

  @@unique([tenantId, number])
  @@index([tenantId, soldAt])
  @@index([tenantId, studentId])
  @@index([tenantId, status])
}

model StoreSaleLine {
  id             String @id @default(cuid())
  tenantId       String
  saleId         String
  itemId         String
  description    String
  quantity       Int
  unitPriceMinor Int
  discountMinor  Int    @default(0)
  taxPercent     Float  @default(0)
  taxMinor       Int    @default(0)
  /// Line total after discount, GST included.
  amountMinor    Int
  unitCostMinor  Int    @default(0)

  sale StoreSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item StoreItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleId])
  @@index([tenantId, itemId])
}

// ===========================================================================
// FRONT OFFICE + ADMISSION CRM
// ===========================================================================

model Visitor {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  phone        String?
  purpose      String
  toMeet       String?
  idProofNo    String?
  personCount  Int       @default(1)
  checkInAt    DateTime  @default(now())
  checkOutAt   DateTime?
  passNumber   String?
  photoUrl     String?
  recordedById String?

  @@index([tenantId, checkInAt])
}

model Appointment {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  withStaffId String?
  visitorName String
  phone       String?
  scheduledAt DateTime
  status      String   @default("SCHEDULED") // SCHEDULED | DONE | CANCELLED | NO_SHOW
  notes       String?
  createdAt   DateTime @default(now())

  @@index([tenantId, scheduledAt])
}

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  CAMPUS_VISIT
  APPLICATION
  DOCUMENT_VERIFICATION
  APPROVED
  ENROLLED
  LOST
}

model AdmissionLead {
  id                 String    @id @default(cuid())
  tenantId           String
  reference          String
  studentName        String
  parentName         String
  phone              String
  email              String?
  source             String? // WALK_IN | REFERRAL | WEBSITE | CALL | ADS
  interestedClassId  String?
  stage              LeadStage @default(NEW)
  stageOrder         Int       @default(0)
  assignedToId       String?
  nextFollowUpOn     DateTime? @db.Date
  lostReason         String?
  notes              String?
  convertedStudentId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  followUps  LeadFollowUp[]
  activities LeadActivity[]
  documents  Document[]

  @@unique([tenantId, reference])
  @@index([tenantId, stage, nextFollowUpOn])
  @@index([tenantId, assignedToId])
}

model LeadFollowUp {
  id           String    @id @default(cuid())
  tenantId     String
  leadId       String
  dueOn        DateTime  @db.Date
  channel      String    @default("CALL")
  note         String?
  doneAt       DateTime?
  outcome      String?
  assignedToId String?
  createdAt    DateTime  @default(now())

  lead AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, dueOn, doneAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  tenantId  String
  leadId    String
  type      String // STAGE_CHANGE | NOTE | CALL | EMAIL | VISIT
  summary   String
  meta      Json?
  actorId   String?
  createdAt DateTime @default(now())

  lead AdmissionLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
}

// ===========================================================================
// TRANSPORT
// ===========================================================================

model Bus {
  id                 String    @id @default(cuid())
  tenantId           String
  code               String
  registrationNo     String
  model              String?
  capacity           Int       @default(40)
  driverId           String?
  attendantName      String?
  /// Identifier the hardware tracker reports itself as — Traccar's uniqueId,
  /// or the IMEI an AIS-140 device sends. Null for a bus tracked only by the
  /// driver's phone.
  gpsDeviceId        String?
  insuranceExpiresOn DateTime? @db.Date
  fitnessExpiresOn   DateTime? @db.Date
  pollutionExpiresOn DateTime? @db.Date
  isActive           Boolean   @default(true)
  deletedAt          DateTime?

  driver      Staff?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  routes      Route[]
  trips       BusTrip[]
  assignments TransportAssignment[]
  locations   BusLocation[]
  maintenance BusMaintenance[]

  @@unique([tenantId, code])
  @@unique([tenantId, registrationNo])
  /// One device reports for one bus. Without this a mistyped id would silently
  /// put two buses on the same dot.
  @@unique([tenantId, gpsDeviceId])
  @@index([tenantId, isActive])
}

model BusMaintenance {
  id        String   @id @default(cuid())
  tenantId  String
  busId     String
  onDate    DateTime @db.Date
  kind      String
  costMinor Int?
  vendor    String?
  notes     String?

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)

  @@index([tenantId, busId, onDate])
}

model Route {
  id         String    @id @default(cuid())
  tenantId   String
  name       String
  code       String
  busId      String?
  distanceKm Float?
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  bus         Bus?                  @relation(fields: [busId], references: [id], onDelete: SetNull)
  stops       BusStop[]
  trips       BusTrip[]
  assignments TransportAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model BusStop {
  id         String  @id @default(cuid())
  tenantId   String
  routeId    String
  name       String
  latitude   Float?
  longitude  Float?
  sortOrder  Int     @default(0)
  pickupTime String?
  dropTime   String?
  fareMinor  Int?

  route             Route                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  assignments       TransportAssignment[]
  boardingLogs      TransportBoardingLog[]
  transportFeeRates TransportFeeRate[]

  @@unique([tenantId, routeId, name])
  @@index([tenantId, routeId, sortOrder])
}

model TransportAssignment {
  id        String    @id @default(cuid())
  tenantId  String
  studentId String
  routeId   String
  stopId    String
  busId     String?
  direction String    @default("BOTH") // PICKUP | DROP | BOTH
  isActive  Boolean   @default(true)
  startedOn DateTime  @default(now())
  endedOn   DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    BusStop @relation(fields: [stopId], references: [id], onDelete: Cascade)
  bus     Bus?    @relation(fields: [busId], references: [id], onDelete: SetNull)

  @@unique([tenantId, studentId, routeId, direction])
  @@index([tenantId, routeId, isActive])
}

enum TripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

model BusTrip {
  id        String     @id @default(cuid())
  tenantId  String
  busId     String
  routeId   String
  driverId  String?
  direction String     @default("PICKUP")
  onDate    DateTime   @db.Date
  status    TripStatus @default(SCHEDULED)
  startedAt DateTime?
  endedAt   DateTime?

  bus       Bus                    @relation(fields: [busId], references: [id], onDelete: Cascade)
  route     Route                  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  driver    Staff?                 @relation(fields: [driverId], references: [id], onDelete: SetNull)
  locations BusLocation[]
  boardings TransportBoardingLog[]

  @@index([tenantId, onDate, status])
}

// High-volume GPS ping table. Written by the driver app, read for live map.
model BusLocation {
  id         String   @id @default(cuid())
  tenantId   String
  busId      String
  tripId     String?
  latitude   Float
  longitude  Float
  speedKph   Float?
  headingDeg Float?
  accuracyM  Float?
  recordedAt DateTime @default(now())

  bus  Bus      @relation(fields: [busId], references: [id], onDelete: Cascade)
  trip BusTrip? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([tenantId, busId, recordedAt])
  @@index([tripId, recordedAt])
}

model TransportBoardingLog {
  id           String   @id @default(cuid())
  tenantId     String
  tripId       String
  studentId    String
  stopId       String?
  event        String // BOARDED | DROPPED | ABSENT
  occurredAt   DateTime @default(now())
  recordedById String?

  trip    BusTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stop    BusStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@unique([tenantId, tripId, studentId, event])
  @@index([tenantId, studentId, occurredAt])
}

// ===========================================================================
// SPORTS + EVENTS
// ===========================================================================

model Sport {
  id           String  @id @default(cuid())
  tenantId     String
  name         String
  category     String?
  coachStaffId String?
  isActive     Boolean @default(true)

  teams SportsTeam[]

  @@unique([tenantId, name])
}

model SportsTeam {
  id           String  @id @default(cuid())
  tenantId     String
  sportId      String
  name         String
  ageGroup     String?
  coachStaffId String?

  sport   Sport              @relation(fields: [sportId], references: [id], onDelete: Cascade)
  members SportsTeamMember[]

  @@unique([tenantId, sportId, name])
}

model SportsTeamMember {
  id        String  @id @default(cuid())
  tenantId  String
  teamId    String
  studentId String
  position  String?
  isCaptain Boolean @default(false)

  team    SportsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, teamId, studentId])
}

model SchoolEvent {
