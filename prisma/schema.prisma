// ===========================================================================
// DOCUMENTS + ATTACHMENTS
// ===========================================================================

enum DocumentOwnerType {
  STUDENT
  PARENT
  STAFF
  SCHOOL
  LEAD
}

model Document {
  id           String            @id @default(cuid())
  tenantId     String
  ownerType    DocumentOwnerType
  studentId    String?
  parentId     String?
  staffId      String?
  leadId       String?
  category     String
  title        String
  // Storage key, not a public URL. Downloads always go through a signed,
  // permission-checked route.
  storageKey   String
  mimeType     String
  sizeBytes    Int
  checksum     String?
  version      Int               @default(1)
  // Set only for the papers that go stale - a medical certificate, an income
  // certificate, a passport. Null means "does not expire", which is most of
  // them, so the missing-document report can treat null as fine rather than
  // as unknown.
  expiresOn    DateTime?         @db.Date
  isVerified   Boolean           @default(false)
  verifiedById String?
  uploadedById String?
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?

  student Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent?        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  staff   Staff?         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  lead    AdmissionLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerType, category])
  @@index([tenantId, studentId])
}

// Lightweight polymorphic attachment used by notices, homework and messages.
model Attachment {
  id           String   @id @default(cuid())
  tenantId     String
  storageKey   String
  fileName     String
  mimeType     String
  sizeBytes    Int
  noticeId     String?
  homeworkId   String?
  submissionId String?
  classworkId  String?
  messageId    String?
  uploadedById String?
  createdAt    DateTime @default(now())

  notice     Notice?             @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  homework   Homework?           @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  submission HomeworkSubmission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  classwork  Classwork?          @relation(fields: [classworkId], references: [id], onDelete: Cascade)
  message    Message?            @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===========================================================================
// BACKGROUND JOBS + BULK IMPORT
// ===========================================================================

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

// Durable job record. The queue driver (in-process or Redis/BullMQ) reads and
// updates these rows so job state survives a restart and stays auditable.
model Job {
  id          String    @id @default(cuid())
  tenantId    String?
  queue       String    @default("default")
  name        String
  payload     Json
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  result      Json?
  createdAt   DateTime  @default(now())

  @@index([status, runAfter])
  @@index([tenantId, name, status])
}

// Staged CSV import so validation, preview and commit stay separate steps.
model ImportBatch {
  id          String    @id @default(cuid())
  tenantId    String
  kind        String
  fileName    String
  storageKey  String?
  totalRows   Int       @default(0)
  validRows   Int       @default(0)
  errorRows   Int       @default(0)
  status      String    @default("VALIDATING")
  errors      Json?
  committedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, kind, status])
}

model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, endpoint])
  @@index([tenantId, userId])
}

// ===========================================================================
// STAFF LIFECYCLE - SALARY, PAYSLIPS AND APPRAISALS
//
// `Staff.salaryMinor` records what somebody is paid in one number, which is
// enough to show on a profile and useless for running a month: it cannot say
// what the figure is made of, when it changed, or what actually left the bank
// in March. These three tables carry that.
//
// Money is integer minor units throughout, like the rest of finance.
// ===========================================================================

/// A salary as of a date. Revisions are inserted, never updated, so a payslip
/// raised last year can still be explained by the structure that produced it.
model StaffSalaryStructure {
  id            String   @id @default(cuid())
  tenantId      String
  staffId       String
  effectiveFrom DateTime @db.Date

  basicMinor      Int @default(0)
  hraMinor        Int @default(0)
  allowancesMinor Int @default(0)
  // Statutory and recurring deductions: PF, professional tax, insurance.
  deductionsMinor Int @default(0)

  // Stored rather than computed on read so a payslip and the structure behind
  // it can never disagree after a rounding rule changes.
  grossMinor Int @default(0)
  netMinor   Int @default(0)

  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, effectiveFrom])
  @@index([tenantId, staffId, effectiveFrom])
}

enum PayslipStatus {
  DRAFT
  PUBLISHED
  PAID
}

/// One month for one person. Draft until checked, published when the payslip
/// is visible to the member of staff, paid once the money has gone out.
model StaffPayslip {
  id          String @id @default(cuid())
  tenantId    String
  staffId     String
  periodYear  Int
  periodMonth Int // 1-12

  // Attendance-derived, but frozen at generation: a register corrected in
  // June must not silently restate a March payslip.
  workingDays     Int   @default(0)
  paidDays        Float @default(0)
  lateCount       Int   @default(0)
  absentCount     Int   @default(0)
  halfDayCount    Int   @default(0)
  /// Every three LATE marks become one unpaid day when the draft is generated.
  latePenaltyDays Int   @default(0)

  basicMinor            Int     @default(0)
  hraMinor              Int     @default(0)
  allowancesMinor       Int     @default(0)
  bonusMinor            Int     @default(0)
  /// Total recurring + manual deductions, excluding attendance loss of pay.
  deductionsMinor       Int     @default(0)
  manualDeductionMinor  Int     @default(0)
  manualDeductionReason String?
  /// Loss of pay for unpaid absence, held apart from other deductions so a
  /// query about absence cost does not have to unpick a total.
  lopMinor              Int     @default(0)

  grossMinor Int @default(0)
  netMinor   Int @default(0)

  status        PayslipStatus @default(DRAFT)
  notes         String?
  generatedById String?
  paidAt        DateTime?
  /// How the salary was paid (CASH, BANK_TRANSFER, CHEQUE, UPI); picks the ledger account it is paid from.
  paymentMode   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([tenantId, staffId, periodYear, periodMonth])
  @@index([tenantId, periodYear, periodMonth, status])
  @@index([tenantId, staffId])
}

enum AppraisalStatus {
  DRAFT
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

/// A review cycle for one person.
///
/// Self-assessment and the reviewer's assessment are separate columns rather
/// than one running note, because the point of an appraisal is that the two
/// can differ and both are on the record.
model StaffAppraisal {
  id         String   @id @default(cuid())
  tenantId   String
  staffId    String
  cycleName  String
  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date

  status AppraisalStatus @default(DRAFT)

  selfComment     String?
  reviewerStaffId String?
  reviewerComment String?

  /// 1-5, the weighted mean of the competency ratings below.
  overallRating Float?
  strengths     String?
  improvements  String?
  goals         String?

  /// PROMOTION | INCREMENT | SUSTAIN | IMPROVEMENT_PLAN
  outcome        String?
  incrementMinor Int?

  submittedAt DateTime?
  completedAt DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  staff    Staff                  @relation("AppraisalSubject", fields: [staffId], references: [id], onDelete: Cascade)
  reviewer Staff?                 @relation("AppraisalReviewer", fields: [reviewerStaffId], references: [id], onDelete: SetNull)
  ratings  StaffAppraisalRating[]

  @@unique([tenantId, staffId, cycleName])
  @@index([tenantId, status, periodTo])
  @@index([tenantId, staffId])
}

model StaffAppraisalRating {
  id          String  @id @default(cuid())
  tenantId    String
  appraisalId String
  competency  String
  rating      Int // 1-5
  comment     String?

  appraisal StaffAppraisal @relation(fields: [appraisalId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appraisalId, competency])
  @@index([tenantId, appraisalId])
}

// ===========================================================================
// HEALTH SCORE
// ===========================================================================

enum ScoreSubject {
  STUDENT
  SECTION
  CLASS
  SCHOOL
  STAFF
}

/// One metric's share of a population's score.
///
/// Rows exist only for metrics a school has changed; anything absent falls back
/// to the default in `lib/score.ts`. That keeps a school on the shipped
/// defaults until it deliberately moves off them, and means adding a metric in
/// a later release does not require a data migration to give every tenant a
/// weight for it.
model ScoreWeight {
  id String @id @default(cuid())

  tenantId   String
  /// STUDENT or STAFF. Each population has its own metric set and its own
  /// weights: attendance means something different for a child and a teacher.
  population String
  metric     String
  /// Relative, not a percentage. Weights are normalised at read time, so a
  /// school can enter 3/2/1 without having to make them add up to anything.
  weight     Int     @default(0)
  isEnabled  Boolean @default(true)

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, population, metric])
  @@index([tenantId, population])
}

/// A score as it stood on one day.
///
/// Scores are derived, so they are recomputed live wherever they are shown —
/// this table exists only to answer "is it getting better?", which no amount of
/// recomputation can answer after the fact. Captured deliberately rather than
/// on every page view, so the trend is a record of the school's own checkpoints
/// rather than an artefact of who happened to open a screen.
model ScoreSnapshot {
  id String @id @default(cuid())

  tenantId    String
  sessionId   String?
  subjectType ScoreSubject
  /// Empty string for the school as a whole, which has no id of its own.
  subjectId   String       @default("")
  /// Denormalised so a snapshot still reads correctly after a rename, or after
  /// a student leaves.
  subjectName String

  score     Float
  band      String
  /// 0-1: the share of enabled weight that actually had data behind it. A high
  /// score built on a quarter of the weight is not the same claim as one built
  /// on all of it, and the difference has to survive into the history.
  coverage  Float  @default(1)
  /// Per-metric sub-scores and weights as they stood, so an old snapshot can be
  /// explained without guessing what the weights were that day.
  breakdown Json

  capturedOn   DateTime @db.Date
  capturedById String?
  createdAt    DateTime @default(now())

  @@unique([tenantId, subjectType, subjectId, capturedOn])
  @@index([tenantId, subjectType, capturedOn])
}

/// A saved ROI calculation.
///
/// Inputs and assumptions are stored beside the results, not instead of them:
/// a figure quoted in a meeting has to be re-derivable months later, and a
/// stored total alone cannot be defended when a school comes back with
/// questions about how it was reached.
model RoiCalculation {
  id String @id @default(cuid())

  tenantId String

  schoolName  String
  contactName String?
  email       String?
  phone       String?

  studentCount   Int
  scenario       String
  includeRevenue Boolean @default(false)

  inputs      Json
  assumptions Json
  results     Json

  /// Denormalised so the list can be read and sorted without parsing the blob.
  netMonthlyBenefit Float
  roiPercent        Float?

  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

/// A credential a GPS server or tracker vendor uses to post positions.
///
/// Machine-to-machine, so a session cookie is no use: the caller is a Traccar
/// instance or a vendor's server, not a person. Only the hash is stored — the
/// token itself is shown once at creation and is unrecoverable afterwards,
/// because a credential an administrator can re-read is one an attacker can
/// read too.
model GpsIngestToken {
  id String @id @default(cuid())

  tenantId String
  /// What it is for, in the administrator's words: "Traccar", "Vendor XYZ".
  name     String

  /// SHA-256 of the token. Never the token.
  tokenHash String @unique
  /// First few characters, so a token can be recognised in a list without
  /// being reproducible from it.
  prefix    String

  lastUsedAt  DateTime?
  /// Kept rather than deleted, so a revoked credential still explains the
  /// positions it wrote while it was live.
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([tenantId, revokedAt])
}

// ===========================================================================
// DEVICE GATEWAY / MYCAMPUSVIEW CONNECT (biometric attendance)
//
// Schools keep existing hardware on their LAN. MyCampusView Connect (Windows
// service) talks to the device and pushes events outbound over HTTPS. The
// cloud never dials private IPs. Vendor SDKs stay inside Connect adapters;
// these tables are brand-agnostic.
// ===========================================================================

enum DeviceConnectorStatus {
  PENDING
  ONLINE
  OFFLINE
  REVOKED
  DISABLED
}

enum BiometricDeviceStatus {
  ONLINE
  OFFLINE
  SYNCING
  ERROR
  DISABLED
}

enum BiometricDevicePurpose {
  STUDENT
  STAFF
  BOTH
  ACCESS_ONLY
}

enum BiometricVerificationMethod {
  FINGERPRINT
  RFID
  PIN
  FACE
  UNKNOWN
}

enum BiometricEventDirection {
  IN
  OUT
  UNKNOWN
}

enum DeviceRawEventStatus {
  PENDING
  PROCESSED
  UNMAPPED
  SKIPPED
  FAILED
  CONFLICT
}

enum DeviceUserSubjectType {
  STUDENT
  STAFF
}

enum DeviceCommandType {
  SYNC_DEVICE
  TEST_CONNECTION
  READ_USERS
  REFRESH_INFO
  SYNC_DEVICE_TIME
}

enum DeviceCommandStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

/// Windows Connect instance paired to one school (tenant).
model DeviceConnector {
  id            String                @id @default(cuid())
  tenantId      String
  name          String
  /// Public identifier sent by Connect (not secret).
  connectorKey  String                @unique
  /// SHA-256 of the long-lived secret issued at pairing.
  secretHash    String
  secretPrefix  String
  status        DeviceConnectorStatus @default(PENDING)
  enabled       Boolean               @default(true)
  version       String?
  hostname      String?
  osInfo        String?
  pendingEvents Int                   @default(0)
  lastSeenAt    DateTime?
  pairedAt      DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  devices  BiometricDevice[]
  events   DeviceRawEvent[]
  commands DeviceCommand[]
  mappings DeviceUserMapping[]

  @@index([tenantId, status])
  @@index([tenantId, lastSeenAt])
}

/// Short-lived single-use pairing code (e.g. MCV-74K9-PQ2M).
model DevicePairingCode {
  id                String    @id @default(cuid())
  tenantId          String
  /// Normalised uppercase code without separators for lookup.
  codeHash          String    @unique
  /// Display form shown to the admin once.
  codeDisplay       String
  connectorName     String?
  expiresAt         DateTime
  usedAt            DateTime?
  usedByConnectorId String?
  createdById       String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, expiresAt])
}

/// Physical attendance device behind a connector (Realtime RS9W, future brands).
model BiometricDevice {
  id                  String                 @id @default(cuid())
  tenantId            String
  connectorId         String
  name                String
  brand               String
  model               String
  /// Free-text wing/gate label — there is no Campus entity in the schema yet.
  locationLabel       String?
  purpose             BiometricDevicePurpose @default(BOTH)
  /// Connector-local device id (stable for that Connect install).
  localDeviceId       String
  serialNumber        String?
  machineNumber       String?
  networkAddress      String?
  port                Int?
  /// Encrypted connection password if the device uses one.
  connectionSecretEnc String?
  configJson          Json?
  status              BiometricDeviceStatus  @default(OFFLINE)
  syncEnabled         Boolean                @default(true)
  active              Boolean                @default(true)
  lastConnectedAt     DateTime?
  lastEventAt         DateTime?
  lastSyncAt          DateTime?
  lastError           String?
  clockDriftSec       Int?
  firmware            String?
  userCount           Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  connector     DeviceConnector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  events        DeviceRawEvent[]
  mappings      DeviceUserMapping[]
  commands      DeviceCommand[]
  cloudEndpoint CloudBiometricEndpoint?

  @@unique([tenantId, connectorId, localDeviceId])
  @@index([tenantId, status])
  @@index([tenantId, active])
}

/// Public FKWeb endpoint for a terminal that connects directly over the internet.
/// Plaintext device and URL tokens are never stored.
model CloudBiometricEndpoint {
  id                 String    @id @default(cuid())
  tenantId           String
  deviceId           String    @unique
  ingestTokenHash    String    @unique
  ingestTokenPrefix  String
  pushDeviceIdHash   String    @unique
  pushDeviceIdSuffix String
  allowedSourceIp    String?
  active             Boolean   @default(true)
  lastSeenAt         DateTime?
  lastSourceIp       String?
  lastError          String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  device BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@index([tenantId, lastSeenAt])
}

model DeviceUserMapping {
  id             String                @id @default(cuid())
  tenantId       String
  /// Scope: same external id may be shared across devices, or per-device.
  connectorId    String?
  deviceId       String?
  externalUserId String
  displayName    String?
  subjectType    DeviceUserSubjectType
  studentId      String?
  staffId        String?
  active         Boolean               @default(true)
  lastPunchAt    DateTime?
  createdById    String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  connector DeviceConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  device    BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalUserId])
  @@index([tenantId, externalUserId])
  @@index([tenantId, studentId])
  @@index([tenantId, staffId])
  @@index([tenantId, active])
}

/// Immutable source-of-truth punch from hardware (or simulator).
model DeviceRawEvent {
  id                  String                      @id @default(cuid())
  tenantId            String
  connectorId         String
  deviceId            String
  externalUserId      String
  /// Vendor log id when available; otherwise stable composite.
  dedupeKey           String
  deviceEventId       String?
  deviceLocalAt       DateTime
  receivedAt          DateTime                    @default(now())
  verificationMethod  BiometricVerificationMethod @default(UNKNOWN)
  direction           BiometricEventDirection     @default(UNKNOWN)
  rawPayload          Json?
  status              DeviceRawEventStatus        @default(PENDING)
  mappingId           String?
  studentId           String?
  staffId             String?
  studentAttendanceId String?
  staffAttendanceId   String?
  processedAt         DateTime?
  processError        String?
  notifiedAt          DateTime?

  connector DeviceConnector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  device    BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, deviceLocalAt])
  @@index([tenantId, status, receivedAt])
  @@index([tenantId, externalUserId, deviceLocalAt])
  @@index([tenantId, deviceId, deviceLocalAt])
  @@index([tenantId, studentId, deviceLocalAt])
  @@index([tenantId, staffId, deviceLocalAt])
}

/// Cloud → connector command (connector polls; no inbound school firewall holes).
model DeviceCommand {
  id          String              @id @default(cuid())
  tenantId    String
  connectorId String
  deviceId    String?
  type        DeviceCommandType
  payload     Json?
  status      DeviceCommandStatus @default(PENDING)
  resultJson  Json?
  error       String?
  createdById String?
  createdAt   DateTime            @default(now())
  claimedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime?

  connector DeviceConnector  @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  device    BiometricDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, connectorId, status])
  @@index([connectorId, status, createdAt])
}

// ===========================================================================
// GROWTH CRM (platform-only — not tenant-scoped)
//
// A prospect is not a MyCampusView tenant. Records live on the platform
// console and may later be linked to a Tenant via wonTenantId when a deal
// is won and onboarding starts.
// ===========================================================================

enum CrmStage {
  PROSPECT
  CONTACTED
  MEETING_SCHEDULED
  DEMO_COMPLETED
  FOLLOW_UP
  PROPOSAL_SENT
  NEGOTIATION
  PILOT
  WON
  LOST
  ON_HOLD
  NOT_INTERESTED
}

enum CrmTemperature {
  COLD
  WARM
  HOT
}

enum CrmFollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum CrmMeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CrmTaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CrmSchool {
  id   String @id @default(cuid())
  name String

  schoolType       String?
  board            String?
  studentCount     Int?
  branchCount      Int?
  city             String?
  state            String?
  address          String?
  website          String?
  phone            String?
  email            String?
  currentErp       String?
  currentErpVendor String?
  erpRenewalOn     DateTime? @db.Date

  leadSource    String?
  campaign      String?
  sourceDetails String?
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?

  ownerId     String?
  createdById String?
  owner       User?   @relation("CrmSchoolOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User?   @relation("CrmSchoolCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  temperature       CrmTemperature @default(COLD)
  temperatureManual Boolean        @default(false)
  stage             CrmStage       @default(PROSPECT)
  stageChangedAt    DateTime       @default(now())

  dealValueMinor   Int       @default(0)
  arrMinor         Int       @default(0)
  probability      Int       @default(10)
  expectedCloseOn  DateTime? @db.Date
  competitor       String?
  primaryObjection String?
  budgetRange      String?
  decisionTimeline String?
  nextFollowUpAt   DateTime?
  nextAction       String?
  lastActivityAt   DateTime?

  lostReason     String?
  lostCompetitor String?
  lostNotes      String?
  recontactOn    DateTime? @db.Date

  /// Set when this prospect becomes an onboarded MyCampusView tenant.
  wonTenantId String?
  notes       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts       CrmContact[]
  opportunities  CrmOpportunity[]
  activities     CrmActivity[]
  followUps      CrmFollowUp[]
  visits         CrmVisit[]
  meetings       CrmMeeting[]
  tasks          CrmTask[]
  communications CrmCommunication[]
  platformEmails PlatformEmail[]
  photos         CrmPhoto[]

  @@index([stage, nextFollowUpAt])
  @@index([ownerId])
  @@index([lastActivityAt])
  @@index([leadSource])
  @@index([name])
  @@index([city])
  @@index([phone])
  @@index([wonTenantId])
}

model CrmContact {
  id               String  @id @default(cuid())
  schoolId         String
  fullName         String
  designation      String?
  mobile           String?
  whatsapp         String?
  email            String?
  preferredChannel String?
  isDecisionMaker  Boolean @default(false)
  isInfluencer     Boolean @default(false)
  isPrimary        Boolean @default(false)
  notes            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  school         CrmSchool          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  followUps      CrmFollowUp[]
  tasks          CrmTask[]
  communications CrmCommunication[]

  @@index([schoolId])
  @@index([mobile])
  @@index([email])
}

model CrmOpportunity {
  id              String    @id @default(cuid())
  schoolId        String
  title           String    @default("MyCampusView")
  stage           CrmStage  @default(PROSPECT)
  stageChangedAt  DateTime  @default(now())
  dealValueMinor  Int       @default(0)
  arrMinor        Int       @default(0)
  probability     Int       @default(10)
  expectedCloseOn DateTime? @db.Date
  ownerId         String?
  owner           User?     @relation("CrmOpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lostReason      String?
  lostCompetitor  String?
  lostNotes       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school CrmSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@index([ownerId])
  @@index([schoolId])
}

model CrmActivity {
  id         String   @id @default(cuid())
  schoolId   String
  contactId  String?
  type       String
  summary    String
  body       String?
  meta       Json?
  actorId    String?
  actorLabel String?
  createdAt  DateTime @default(now())

  school CrmSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([type])
}

model CrmFollowUp {
  id            String            @id @default(cuid())
  schoolId      String
  contactId     String?
  dueAt         DateTime
  type          String            @default("CALL")
  priority      String            @default("NORMAL")
  note          String?
  status        CrmFollowUpStatus @default(PENDING)
  assignedToId  String?
  assignedTo    User?             @relation("CrmFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedAt   DateTime?
  completedById String?
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  school  CrmSchool   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([dueAt, status])
  @@index([schoolId, status])
  @@index([assignedToId, status])
}

model CrmVisit {
  id                 String    @id @default(cuid())
  schoolId           String
  visitedAt          DateTime
  endedAt            DateTime?
  teamMembers        String?
  contactsMet        String?
  purpose            String?
  meetingType        String?
  summary            String
  painPoints         String?
  currentErp         String?
  liked              String?
  objections         String?
  competitors        String?
  outcome            String?
  nextAction         String?
  documentsRequested String?
  dealConfidence     String?
  createdById        String?
  createdBy          User?     @relation("CrmVisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())

  school CrmSchool  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  photos CrmPhoto[]

  @@index([schoolId, visitedAt])
  @@index([visitedAt])
}

/// A photo taken on a field visit (school front, notice board, prospectus…).
model CrmPhoto {
  id           String    @id @default(cuid())
  schoolId     String
  visitId      String?
  storageKey   String    @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdById  String?
  createdLabel String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  school CrmSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  visit  CrmVisit? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([visitId])
}

model CrmMeeting {
  id          String           @id @default(cuid())
  schoolId    String
  startsAt    DateTime
  endsAt      DateTime?
  meetingType String           @default("Discovery")
  mode        String           @default("PHYSICAL")
  location    String?
  meetingLink String?
  agenda      String?
  notes       String?
  contactIds  String[]         @default([])
  attendeeIds String[]         @default([])
  status      CrmMeetingStatus @default(SCHEDULED)
  createdById String?
  createdBy   User?            @relation("CrmMeetingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  school CrmSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([startsAt, status])
  @@index([schoolId, status])
}

model CrmTask {
  id          String        @id @default(cuid())
  schoolId    String
  contactId   String?
  title       String
  description String?
  dueAt       DateTime?
  priority    String        @default("NORMAL")
  status      CrmTaskStatus @default(TODO)
  ownerId     String?
  owner       User?         @relation("CrmTaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedAt DateTime?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  school  CrmSchool   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([dueAt, status])
  @@index([schoolId, status])
  @@index([ownerId, status])
}

/// Idempotency log for Growth CRM reminder emails. Platform-only.
model CrmReminderSend {
  id        String   @id @default(cuid())
  kind      String
  targetKey String
  sentAt    DateTime @default(now())

  @@unique([kind, targetKey])
  @@index([sentAt])
}

/// Sales message templates. Platform-only — not tenant NotificationTemplate.
model CrmTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String
  channel   String
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  communications CrmCommunication[]

  @@index([channel, isActive])
  @@index([category])
}

/// Outbound WhatsApp / SMS / email from Growth CRM. Platform-only.
model CrmCommunication {
  id                String   @id @default(cuid())
  schoolId          String
  contactId         String?
  channel           String
  to                String
  subject           String?
  body              String
  status            String
  provider          String?
  providerMessageId String?
  error             String?
  templateId        String?
  actorId           String?
  actorLabel        String?
  createdAt         DateTime @default(now())

  school   CrmSchool    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  contact  CrmContact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  template CrmTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([schoolId, createdAt])
  @@index([channel, status])
}

// ---------------------------------------------------------------------------
// Platform mail: the MyCampusView team's own mailbox (e.g. Hostinger), used
// from the console to send proposals and correspondence. Platform-only.
// ---------------------------------------------------------------------------

model PlatformMailbox {
  id                 String    @id @default(cuid())
  fromName           String
  fromEmail          String    @unique
  replyTo            String?
  username           String
  /// AES-256-GCM via encryptSecret(). Never returned to a browser.
  passwordEncrypted  String
  smtpHost           String    @default("smtp.hostinger.com")
  smtpPort           Int       @default(465)
  smtpSecure         Boolean   @default(true)
  /// SMTP, or RESEND (HTTPS API) for hosts that block outbound mail ports.
  sendVia            String    @default("SMTP")
  /// AES-256-GCM via encryptSecret(). Falls back to RESEND_API_KEY when empty.
  resendKeyEncrypted String?
  imapEnabled        Boolean   @default(true)
  imapHost           String    @default("imap.hostinger.com")
  imapPort           Int       @default(993)
  /// Detected on first successful append; blank until then.
  sentFolder         String?
  signatureName      String?
  signatureTitle     String?
  signaturePhone     String?
  signatureWebsite   String?
  isDefault          Boolean   @default(false)
  verifiedAt         DateTime?
  lastError          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  emails    PlatformEmail[]
  campaigns PlatformCampaign[]
}

/// One message sent individually to a list of schools, usually from a CSV.
/// Each recipient gets their own copy, personalised, with an unsubscribe link.
model PlatformCampaign {
  id               String    @id @default(cuid())
  name             String
  mailboxId        String?
  subject          String
  /// Sanitised editor content with {{placeholders}} still in place.
  bodyHtml         String
  layout           String    @default("BRANDED")
  demoButton       Boolean   @default(false)
  includeSignature Boolean   @default(true)
  documentIds      String[]
  /// DRAFT, SENDING, PAUSED, COMPLETED, CANCELLED
  status           String    @default("DRAFT")
  sourceFileName   String?
  lastError        String?
  actorId          String?
  actorLabel       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?

  mailbox    PlatformMailbox?            @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  recipients PlatformCampaignRecipient[]

  @@index([createdAt])
}

model PlatformCampaignRecipient {
  id             String    @id @default(cuid())
  campaignId     String
  email          String
  schoolName     String?
  contactName    String?
  area           String?
  crmSchoolId    String?
  /// PENDING, SENDING, SENT, FAILED, SKIPPED
  status         String    @default("PENDING")
  skipReason     String?
  error          String?
  messageId      String?
  /// Opaque, unguessable; identifies the recipient on the public unsubscribe page.
  token          String    @unique
  sentAt         DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  campaign PlatformCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
}

/// Addresses that asked not to be emailed again. Checked before every bulk send.
model PlatformUnsubscribe {
  id         String   @id @default(cuid())
  email      String   @unique
  /// LINK (unsubscribe page), ONE_CLICK (mail client button), MANUAL (added by the team)
  source     String
  campaignId String?
  reason     String?
  createdAt  DateTime @default(now())
}

model PlatformEmail {
  id            String   @id @default(cuid())
  mailboxId     String?
  fromName      String
  fromEmail     String
  to            String[]
  cc            String[]
  bcc           String[]
  subject       String
  /// The complete rendered HTML exactly as sent.
  html          String
  text          String
  /// Sanitised editor content, used to start a new draft from this email.
  bodyHtml      String
  layout        String   @default("BRANDED")
  status        String
  messageId     String?
  error         String?
  savedToSent   Boolean  @default(false)
  sentCopyError String?
  crmSchoolId   String?
  actorId       String?
  actorLabel    String?
  createdAt     DateTime @default(now())

  mailbox     PlatformMailbox?          @relation(fields: [mailboxId], references: [id], onDelete: SetNull)
  crmSchool   CrmSchool?                @relation(fields: [crmSchoolId], references: [id], onDelete: SetNull)
  attachments PlatformEmailAttachment[]

  @@index([createdAt])
  @@index([status])
  @@index([crmSchoolId])
}

model PlatformEmailAttachment {
  id         String  @id @default(cuid())
  emailId    String
  documentId String?
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  email    PlatformEmail     @relation(fields: [emailId], references: [id], onDelete: Cascade)
  document PlatformDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([emailId])
}

/// Reusable files (proposals, brochures, quotations) attachable in one click.
model PlatformDocument {
  id              String    @id @default(cuid())
  title           String
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String    @unique
  uploadedById    String?
  uploadedByLabel String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  attachments PlatformEmailAttachment[]

  @@index([deletedAt, createdAt])
}

// ---------------------------------------------------------------------------
// AI School Lead Discovery (platform Growth CRM extension)
// Staging + run history only — qualified leads still land in CrmSchool.
// ---------------------------------------------------------------------------

enum CrmDiscoveryVerification {
  VERIFIED
  STRONG_LEAD
  NEEDS_VERIFICATION
  REJECTED
}

enum CrmDiscoveryPriority {
  HOT
  HIGH
  MEDIUM
  LOW
}

enum CrmDiscoveryRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model CrmDiscoveryLocation {
  id           String   @id @default(cuid())
  city         String
  region       String?
  state        String   @default("Haryana")
  enabled      Boolean  @default(true)
  searchRadius Int?
  priority     Int      @default(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidates CrmDiscoveryCandidate[]
  runs       CrmDiscoveryRun[]

  @@unique([city, state])
  @@index([enabled, priority])
}

model CrmDiscoverySettings {
  id                       String   @id @default("default")
  enabled                  Boolean  @default(true)
  /// Daily cron window label; actual schedule is external (CRON_SECRET).
  frequency                String   @default("daily")
  minConfidence            Int      @default(60)
  autoAddVerified          Boolean  @default(true)
  autoAddStrongLead        Boolean  @default(true)
  autoAddNeedsVerification Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

model CrmDiscoveryRun {
  id           String                @id @default(cuid())
  locationId   String?
  status       CrmDiscoveryRunStatus @default(PENDING)
  startedAt    DateTime              @default(now())
  finishedAt   DateTime?
  queries      Int                   @default(0)
  resultsFound Int                   @default(0)
  createdLeads Int                   @default(0)
  updatedLeads Int                   @default(0)
  duplicates   Int                   @default(0)
  rejected     Int                   @default(0)
  needsReview  Int                   @default(0)
  errors       Json?
  summary      String?
  triggeredBy  String?

  location   CrmDiscoveryLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  candidates CrmDiscoveryCandidate[]

  @@index([startedAt])
  @@index([status])
}

model CrmDiscoveryCandidate {
  id         String  @id @default(cuid())
  runId      String?
  locationId String?

  schoolName  String
  branchName  String?
  schoolGroup String?
  area        String?
  sector      String?
  city        String?
  state       String?
  postalCode  String?

  normalizedKey String

  openingDate     DateTime? @db.Date
  openingMonth    Int?
  openingYear     Int?
  academicSession String?
  schoolStatus    String?
  openingEvidence String?

  contactPerson  String?
  designation    String?
  phone          String?
  alternatePhone String?
  email          String?
  website        String?
  address        String?

  /// 0–100 average of the email, phone and address confidences (missing = 0).
  contactConfidence Int       @default(0)
  /// ContactFindings (src/lib/lead-discovery.ts): value, source page and confidence per detail.
  contactFindings   Json?
  contactCheckedAt  DateTime?

  verificationStatus CrmDiscoveryVerification @default(NEEDS_VERIFICATION)
  confidenceScore    Int                      @default(0)
  salesPriority      CrmDiscoveryPriority     @default(MEDIUM)
  opportunityScore   Int                      @default(0)

  discoverySummary String?
  whyThisLead      String?
  recommendedPitch String?

  crmSchoolId    String?   @unique
  crmLinkedAt    DateTime?
  rejectedAt     DateTime?
  rejectedReason String?

  discoveredAt   DateTime  @default(now())
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  run      CrmDiscoveryRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  location CrmDiscoveryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  evidence CrmDiscoveryEvidence[]

  @@index([normalizedKey])
  @@index([verificationStatus, salesPriority])
  @@index([city, discoveredAt])
  @@index([crmSchoolId])
}

model CrmDiscoveryEvidence {
  id          String    @id @default(cuid())
  candidateId String
  url         String
  title       String?
  sourceName  String?
  sourceType  String
  snippet     String?
  publishedAt DateTime?
  foundAt     DateTime  @default(now())
  weight      Int       @default(0)

  candidate CrmDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([url])
}

// ===========================================================================
// TALLY.ERP 9 INTEGRATION
//
// Cloud never dials the school LAN. The school runs a local Tally Connector
// (same pairing/command pattern as DeviceConnector) that talks to Tally on
// localhost:9000 via XML over HTTP and reports results back.
//
// DIRECT mode exists only for self-hosted deployments where the app can reach
// Tally safely — it is off by default and gated by env.
// ===========================================================================

enum TallyProviderKind {
  ERP9
  PRIME
}

enum TallyConnectionMode {
  CONNECTOR
  DIRECT
}

enum TallyPartyModel {
  STUDENT_LEDGER
  CLASS_LEDGER
  FEE_CATEGORY_LEDGER
  CUSTOM
}

enum TallyConnectionHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  OFFLINE
  REQUIRES_ATTENTION
}

enum TallyConnectorStatus {
  PENDING
  ONLINE
  OFFLINE
  DISABLED
  REVOKED
}

enum TallyCommandType {
  TEST_CONNECTION
  LIST_COMPANIES
  FETCH_MASTERS
  CREATE_LEDGER
  CREATE_RECEIPT_VOUCHER
  CREATE_PAYMENT_VOUCHER
  FETCH_VOUCHERS
  FETCH_BALANCES
  RECONCILE
}

enum TallyCommandStatus {
  PENDING
  CLAIMED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum TallyMappingKind {
  FEE_HEAD
  PAYMENT_MODE
  STUDENT
  EXPENSE_CATEGORY
  VENDOR
  COST_CENTRE
  VOUCHER_TYPE
  INCOME_LEDGER
}

enum TallySyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  RETRYING
  REQUIRES_REVIEW
  SKIPPED
}

enum TallyEntityKind {
  FEE_PAYMENT
  FEE_RECEIPT
  SCHOOL_EXPENSE
  LEDGER
  MASTER
}

enum TallyReconStatus {
  MATCHED
  UNMATCHED_MCV
  UNMATCHED_TALLY
  AMOUNT_MISMATCH
  DATE_MISMATCH
  LEDGER_MISMATCH
  DUPLICATE
  FAILED_SYNC
  REVIEW
}

/// One row per school. Holds company, sync flags and accounting model.
model TallyIntegration {
  id                  String                @id @default(cuid())
  tenantId            String                @unique
  enabled             Boolean               @default(false)
  provider            TallyProviderKind     @default(ERP9)
  mode                TallyConnectionMode   @default(CONNECTOR)
  companyName         String?
  companyGuid         String?
  /// DIRECT mode only — never expose to browsers. Prefer private IP / hostname.
  host                String?
  port                Int                   @default(9000)
  timeoutMs           Int                   @default(15000)
  syncFrequencyMin    Int                   @default(15)
  autoSyncReceipts    Boolean               @default(true)
  autoSyncExpenses    Boolean               @default(false)
  autoCreateLedgers   Boolean               @default(false)
  autoSyncMasters     Boolean               @default(false)
  testMode            Boolean               @default(true)
  partyModel          TallyPartyModel       @default(STUDENT_LEDGER)
  health              TallyConnectionHealth @default(UNKNOWN)
  lastConnectionAt    DateTime?
  lastConnectionError String?
  lastSyncAt          DateTime?
  lastMasterSyncAt    DateTime?
  settingsJson        Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  connectors      TallyConnector[]
  commands        TallyCommand[]
  ledgers         TallyLedgerCache[]
  mappings        TallyMapping[]
  voucherLinks    TallyVoucherLink[]
  syncLogs        TallySyncLog[]
  accountingRules TallyAccountingRule[]
  reconItems      TallyReconciliationItem[]

  @@index([enabled, health])
}

model TallyConnector {
  id            String               @id @default(cuid())
  tenantId      String
  integrationId String
  name          String
  connectorKey  String               @unique
  secretHash    String
  secretPrefix  String
  status        TallyConnectorStatus @default(PENDING)
  enabled       Boolean              @default(true)
  version       String?
  hostname      String?
  osInfo        String?
  tallyHost     String               @default("127.0.0.1")
  tallyPort     Int                  @default(9000)
  pendingJobs   Int                  @default(0)
  lastSeenAt    DateTime?
  pairedAt      DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  commands    TallyCommand[]

  @@index([tenantId, status])
  @@index([tenantId, lastSeenAt])
  @@index([integrationId])
}

model TallyPairingCode {
  id                String    @id @default(cuid())
  tenantId          String
  codeHash          String    @unique
  codeDisplay       String
  connectorName     String?
  expiresAt         DateTime
  usedAt            DateTime?
  usedByConnectorId String?
  createdById       String?
  createdAt         DateTime  @default(now())

  @@index([tenantId, expiresAt])
}

model TallyCommand {
  id             String             @id @default(cuid())
  tenantId       String
  integrationId  String
  connectorId    String?
  type           TallyCommandType
  payload        Json?
  status         TallyCommandStatus @default(PENDING)
  /// schoolId + entity + voucher type — prevents duplicate Tally posts
  idempotencyKey String?
  resultJson     Json?
  error          String?
  errorCode      String?
  attempts       Int                @default(0)
  maxAttempts    Int                @default(5)
  runAfter       DateTime           @default(now())
  createdById    String?
  createdAt      DateTime           @default(now())
  claimedAt      DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  connector   TallyConnector?  @relation(fields: [connectorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, runAfter])
  @@index([connectorId, status, createdAt])
  @@index([integrationId, type, status])
}

/// Snapshot of ledgers/groups imported from Tally (read cache, not source of truth).
model TallyLedgerCache {
  id                  String   @id @default(cuid())
  tenantId            String
  integrationId       String
  name                String
  parent              String?
  guid                String?
  isParty             Boolean  @default(false)
  isRevenue           Boolean  @default(false)
  closingBalanceMinor Int?
  rawJson             Json?
  syncedAt            DateTime @default(now())

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, name])
  @@index([tenantId, parent])
  @@index([integrationId, isParty])
}

model TallyMapping {
  id              String           @id @default(cuid())
  tenantId        String
  integrationId   String
  kind            TallyMappingKind
  /// FeeHead.id / PaymentMode enum / Student.id / ExpenseCategory / etc.
  localKey        String
  localLabel      String?
  tallyLedgerName String
  tallyGuid       String?
  tallyParent     String?
  active          Boolean          @default(true)
  autoMatched     Boolean          @default(false)
  matchScore      Int?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, kind, localKey])
  @@index([tenantId, kind, active])
}

/// Links a MyCampusView money entity to a Tally voucher (idempotent).
model TallyVoucherLink {
  id                 String          @id @default(cuid())
  tenantId           String
  integrationId      String
  entityKind         TallyEntityKind
  entityId           String
  idempotencyKey     String
  status             TallySyncStatus @default(PENDING)
  voucherType        String?
  tallyVoucherNumber String?
  tallyMasterId      String?
  amountMinor        Int?
  voucherDate        DateTime?       @db.Date
  previewJson        Json?
  lastError          String?
  lastErrorCode      String?
  attempts           Int             @default(0)
  lastSyncedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, entityKind, entityId])
  @@index([tenantId, status])
  @@index([integrationId, status, updatedAt])
}

model TallyAccountingRule {
  id                String       @id @default(cuid())
  tenantId          String
  integrationId     String
  name              String
  /// When set, applies to this PaymentMode; null = default receipt rule.
  paymentMode       PaymentMode?
  feeHeadId         String?
  debitLedgerName   String
  creditLedgerName  String?
  voucherType       String       @default("Receipt")
  narrationTemplate String?
  active            Boolean      @default(true)
  sortOrder         Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, integrationId, name])
  @@index([tenantId, paymentMode, active])
}

model TallySyncLog {
  id            String          @id @default(cuid())
  tenantId      String
  integrationId String
  userId        String?
  operation     String
  entityKind    String?
  entityId      String?
  correlationId String
  status        TallySyncStatus
  httpStatus    Int?
  errorCode     String?
  errorMessage  String?
  /// Sanitized / truncated — never store secrets or full PII dumps.
  detailJson    Json?
  durationMs    Int?
  createdAt     DateTime        @default(now())

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([integrationId, status, createdAt])
  @@index([correlationId])
}

model TallyReconciliationItem {
  id               String           @id @default(cuid())
  tenantId         String
  integrationId    String
  runId            String
  status           TallyReconStatus
  mcvEntityKind    TallyEntityKind?
  mcvEntityId      String?
  mcvAmountMinor   Int?
  mcvDate          DateTime?        @db.Date
  tallyVoucherNo   String?
  tallyAmountMinor Int?
  tallyDate        DateTime?        @db.Date
  notes            String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime         @default(now())

  integration TallyIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([tenantId, runId, status])
  @@index([integrationId, status])
}

// ===========================================================================
// ACCOUNTS & LEDGER (internal double-entry books)
// ===========================================================================

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalVoucherType {
  JOURNAL
  RECEIPT
  PAYMENT
  CONTRA
}

enum JournalSourceType {
  MANUAL
  FEE_PAYMENT
  FEE_REFUND
  EXPENSE
  STORE_SALE
  STORE_PURCHASE
  STORE_STOCK
  PAYROLL
  PURCHASE_VOUCHER
  VENDOR_PAYMENT
  DEBIT_NOTE
  VENDOR_ADJUSTMENT
  DEPRECIATION
  FIXED_ASSET
}

enum LedgerMapKind {
  FEE_HEAD
  PAYMENT_MODE
  EXPENSE_CATEGORY
}

/// Chart of accounts. Opening balance is signed: positive = Debit, negative = Credit.
model LedgerAccount {
  id                  String            @id @default(cuid())
  tenantId            String
  code                String
  name                String
  type                LedgerAccountType
  description         String?
  openingBalanceMinor Int               @default(0)
  /// Stable key for accounts the posting engine relies on (CASH, BANK, ...).
  systemKey           String?
  isActive            Boolean           @default(true)
  /// Expense accounts only: drives the direct / indirect split in P&L.
  expenseNature       ExpenseNature?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  lines        JournalLine[]
  expenseHeads ExpenseHead[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@index([tenantId, type])
}

/// A balanced voucher. Posted entries are never edited; corrections post a reversal.
model JournalEntry {
  id             String             @id @default(cuid())
  tenantId       String
  number         String
  voucherType    JournalVoucherType @default(JOURNAL)
  date           DateTime           @db.Date
  reference      String?
  narration      String?
  sourceType     JournalSourceType  @default(MANUAL)
  sourceId       String?
  /// Makes automatic posting idempotent, e.g. FEE_PAYMENT:<id>:v1.
  postingKey     String?
  totalMinor     Int
  isReversal     Boolean            @default(false)
  reversalOfId   String?
  reversedAt     DateTime?
  createdById    String?
  createdByLabel String?
  createdAt      DateTime           @default(now())

  lines JournalLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, postingKey])
  @@index([tenantId, date])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, createdAt])
}

model JournalLine {
  id          String  @id @default(cuid())
  tenantId    String
  entryId     String
  accountId   String
  debitMinor  Int     @default(0)
  creditMinor Int     @default(0)
  memo        String?

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([tenantId, accountId])
  @@index([entryId])
}

/// Which ledger account a fee head, payment mode or expense category posts to.
model LedgerAccountMap {
  id        String        @id @default(cuid())
  tenantId  String
  kind      LedgerMapKind
  localKey  String
  accountId String
  updatedAt DateTime      @updatedAt

  @@unique([tenantId, kind, localKey])
}

model LedgerSettings {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  autoPostFees     Boolean   @default(true)
  autoPostExpenses Boolean   @default(true)
  autoPostStore    Boolean   @default(true)
  lastSyncedAt     DateTime?
  updatedAt        DateTime  @updatedAt
}

// ===========================================================================
// ACCOUNTING EXPANSION (phase 1 foundation). Builds on the ledger above; every
// switch defaults off so existing behaviour is unchanged until a school opts in.
// ===========================================================================

enum AccountingPeriodStatus {
  OPEN
  /// Postings on or before `lockedThrough` are refused; later dates stay open.
  LOCKED
  /// Year-end done: nothing may post into this year.
  CLOSED
}

/// One financial year per school. Postings must fall in an OPEN (or partly
/// locked) year; corrections to a closed year go through a later-dated voucher.
model AccountingFiscalYear {
  id            String                 @id @default(cuid())
  tenantId      String
  /// e.g. "2026-27"
  label         String
  startsOn      DateTime               @db.Date
  endsOn        DateTime               @db.Date
  status        AccountingPeriodStatus @default(OPEN)
  /// Inclusive: no voucher may be dated on or before this day.
  lockedThrough DateTime?              @db.Date
  lockedById    String?
  lockedAt      DateTime?
  closedById    String?
  closedAt      DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([tenantId, label])
  @@unique([tenantId, startsOn])
  @@index([tenantId, startsOn, endsOn])
}

/// Append-only trail of accounting actions: postings, reversals, approvals,
/// period locks and settings changes. Never updated or deleted by the app.
model AccountingAuditEvent {
  id            String   @id @default(cuid())
  tenantId      String
  /// e.g. JournalEntry, AccountingFiscalYear, AccountingSettings
  entityType    String
  entityId      String?
  /// e.g. voucher.posted, voucher.reversed, period.locked, settings.updated
  action        String
  fromStatus    String?
  toStatus      String?
  reason        String?
  actorId       String?
  actorLabel    String?
  /// Idempotency / correlation key; the same key is recorded at most once.
  correlationId String?
  data          Json?
  createdAt     DateTime @default(now())

  @@unique([tenantId, correlationId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
}

/// Per-school switches for the accounting expansion. A missing row means
/// everything is off.
model AccountingSettings {
  id                      String                @id @default(cuid())
  tenantId                String                @unique
  /// Fees card on Student 360 opens the statement of account.
  studentLedgerEnabled    Boolean               @default(false)
  /// Multi-tier expense approval before posting.
  approvalWorkflowEnabled Boolean               @default(false)
  /// Queue WhatsApp receipt notifications after a fee receipt is posted.
  whatsappReceiptsEnabled Boolean               @default(false)
  /// 1-12; Indian schools use 4 (April-March).
  fiscalYearStartMonth    Int                   @default(4)
  /// How often depreciation runs are proposed (phase 5).
  depreciationFrequency   DepreciationFrequency @default(YEARLY)
  updatedById             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

// ---------------------------------------------------------------------------
// Accounts payable (sundry creditors). Isolated tables: no foreign keys to
// existing models. Ledger accounts, store items and users are referenced by id
// and validated in the service, inside the tenant-scoped client.
// ---------------------------------------------------------------------------

model Vendor {
  id            String   @id @default(cuid())
  tenantId      String
  /// Short unique code within the school, e.g. VEN-00001.
  code          String
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  gstin         String?
  pan           String?
  /// Payment terms in days from the supplier invoice date.
  creditDays    Int      @default(0)
  isActive      Boolean  @default(true)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseVouchers PurchaseVoucher[]
  payments         VendorPayment[]
  debitNotes       DebitNote[]
  adjustments      VendorAdjustment[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
}

enum PurchaseVoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

model PurchaseVoucher {
  id                 String                @id @default(cuid())
  tenantId           String
  number             String
  vendorId           String
  supplierInvoiceNo  String
  /// Normalised supplier invoice number for duplicate detection. A cancelled
  /// voucher's key is suffixed so the genuine bill can be entered again.
  supplierInvoiceKey String
  invoiceDate        DateTime              @db.Date
  dueDate            DateTime              @db.Date
  status             PurchaseVoucherStatus @default(DRAFT)
  subtotalMinor      Int
  taxMinor           Int                   @default(0)
  totalMinor         Int
  narration          String?
  attachmentKey      String?
  attachmentName     String?
  attachmentMime     String?
  attachmentSize     Int?
  idempotencyKey     String?
  createdById        String?
  createdByLabel     String?
  postedAt           DateTime?
  postedById         String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancelReason       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  vendor      Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines       PurchaseVoucherLine[]
  allocations VendorPaymentAllocation[]
  debitNotes  DebitNote[]
  adjustments VendorAdjustment[]

  @@unique([tenantId, number])
  @@unique([tenantId, vendorId, supplierInvoiceKey])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, vendorId, status])
  @@index([tenantId, dueDate])
}

model PurchaseVoucherLine {
  id            String  @id @default(cuid())
  tenantId      String
  voucherId     String
  sortOrder     Int     @default(0)
  description   String
  /// Expense or asset ledger account the line is charged to.
  accountId     String
  /// Optional reference to a store item. Never moves stock.
  storeItemId   String?
  quantity      Int     @default(1)
  unitCostMinor Int
  amountMinor   Int
  taxPercent    Float   @default(0)
  taxMinor      Int     @default(0)
  totalMinor    Int

  voucher        PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  debitNoteLines DebitNoteLine[]

  @@index([tenantId, voucherId])
}

enum VendorDocumentStatus {
  POSTED
  CANCELLED
}

model VendorPayment {
  id             String               @id @default(cuid())
  tenantId       String
  number         String
  vendorId       String
  paidOn         DateTime             @db.Date
  /// CASH, BANK_TRANSFER, CHEQUE or UPI.
  mode           String
  reference      String?
  amountMinor    Int
  narration      String?
  status         VendorDocumentStatus @default(POSTED)
  idempotencyKey String?
  createdById    String?
  createdByLabel String?
  createdAt      DateTime             @default(now())
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  vendor      Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  allocations VendorPaymentAllocation[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, vendorId, paidOn])
}

model VendorPaymentAllocation {
  id          String @id @default(cuid())
  tenantId    String
  paymentId   String
  voucherId   String
  amountMinor Int

  payment VendorPayment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  voucher PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@unique([tenantId, paymentId, voucherId])
  @@index([tenantId, voucherId])
}

enum DebitNoteStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model DebitNote {
  id              String          @id @default(cuid())
  tenantId        String
  number          String
  vendorId        String
  voucherId       String
  noteDate        DateTime        @db.Date
  reason          String
  status          DebitNoteStatus @default(SUBMITTED)
  totalMinor      Int
  attachmentKey   String?
  attachmentName  String?
  attachmentMime  String?
  attachmentSize  Int?
  idempotencyKey  String?
  createdById     String?
  createdByLabel  String?
  approvedById    String?
  approvedByLabel String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  cancelledAt     DateTime?
  cancelledById   String?
  cancelReason    String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  voucher PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  lines   DebitNoteLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, vendorId, status])
  @@index([tenantId, voucherId])
}

model DebitNoteLine {
  id            String @id @default(cuid())
  tenantId      String
  debitNoteId   String
  voucherLineId String
  quantity      Int
  amountMinor   Int
  taxMinor      Int    @default(0)
  totalMinor    Int

  debitNote   DebitNote           @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  voucherLine PurchaseVoucherLine @relation(fields: [voucherLineId], references: [id], onDelete: Restrict)

  @@index([tenantId, debitNoteId])
  @@index([tenantId, voucherLineId])
}

enum VendorAdjustmentType {
  DISCOUNT
  WRITE_OFF
}

model VendorAdjustment {
  id             String               @id @default(cuid())
  tenantId       String
  number         String
  vendorId       String
  voucherId      String
  type           VendorAdjustmentType
  adjustedOn     DateTime             @db.Date
  amountMinor    Int
  reason         String
  status         VendorDocumentStatus @default(POSTED)
  idempotencyKey String?
  createdById    String?
  createdByLabel String?
  createdAt      DateTime             @default(now())
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?

  vendor  Vendor          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  voucher PurchaseVoucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)

  @@unique([tenantId, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, vendorId])
  @@index([tenantId, voucherId])
}

// ---------------------------------------------------------------------------
// Accounting phase 5: fixed assets register and WDV depreciation. Separate from
// the inventory Asset table, which it may reference by id (no foreign key).
// ---------------------------------------------------------------------------

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
  /// Entered by mistake; only possible before any depreciation is posted.
  CANCELLED
}

enum FixedAssetCapitalisation {
  /// Cost is already in the books (purchase voucher, journal or opening balance).
  EXISTING
  /// Capitalisation entry posted from the register: Dr asset ledger, Cr funding ledger.
  POSTED
}

enum DepreciationFrequency {
  MONTHLY
  YEARLY
}

enum DepreciationRunStatus {
  SUBMITTED
  POSTED
  REJECTED
  REVERSED
}

model FixedAsset {
  id                        String                   @id @default(cuid())
  tenantId                  String
  /// FA-2627-00001
  code                      String
  name                      String
  category                  String
  location                  String?
  department                String?
  /// Optional link to the inventory register (Asset.id); no foreign key.
  inventoryAssetId          String?
  capitalisedOn             DateTime                 @db.Date
  costMinor                 Int
  residualMinor             Int
  usefulLifeMonths          Int?
  /// Only WDV today; kept as text so further methods are additive.
  method                    String                   @default("WDV")
  /// Current annual rate in basis points of a percent (18.10% = 1810).
  rateBp                    Int
  depreciationStartOn       DateTime                 @db.Date
  /// Depreciation charged before depreciationStartOn (brought-forward assets).
  openingAccumulatedMinor   Int                      @default(0)
  assetAccountId            String
  capitalisation            FixedAssetCapitalisation @default(EXISTING)
  fundingAccountId          String?
  status                    FixedAssetStatus         @default(ACTIVE)
  disposedOn                DateTime?                @db.Date
  disposalProceedsMinor     Int?
  disposalAccountId         String?
  disposalReason            String?
  disposalDepreciationMinor Int?
  disposalGainLossMinor     Int?
  cancelledAt               DateTime?
  cancelReason              String?
  notes                     String?
  idempotencyKey            String?
  createdById               String?
  createdByLabel            String?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  rateChanges FixedAssetRateChange[]
  lines       DepreciationLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, assetAccountId])
}

/// Rate history. Each change applies from `effectiveFrom`, never before the last posted line.
model FixedAssetRateChange {
  id             String   @id @default(cuid())
  tenantId       String
  assetId        String
  effectiveFrom  DateTime @db.Date
  previousRateBp Int
  rateBp         Int
  reason         String
  changedById    String?
  changedByLabel String?
  createdAt      DateTime @default(now())

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([tenantId, assetId, effectiveFrom])
}

model DepreciationRun {
  id              String                @id @default(cuid())
  tenantId        String
  /// DEP-2627-00001
  number          String
  frequency       DepreciationFrequency
  periodStart     DateTime              @db.Date
  periodEnd       DateTime              @db.Date
  /// periodEnd as YYYY-MM-DD while SUBMITTED or POSTED; suffixed when rejected or
  /// reversed, so one active run per period end is enforced by the unique index.
  periodKey       String
  status          DepreciationRunStatus
  totalMinor      Int
  idempotencyKey  String?
  createdById     String?
  createdByLabel  String?
  createdAt       DateTime              @default(now())
  approvedById    String?
  approvedByLabel String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectionReason String?
  rejectedAt      DateTime?
  postedAt        DateTime?
  reversedById    String?
  reversalReason  String?
  reversedAt      DateTime?

  lines DepreciationLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, periodKey])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, periodEnd])
}

model DepreciationLine {
  id                String   @id @default(cuid())
  tenantId          String
  runId             String
  assetId           String
  fromDate          DateTime @db.Date
  toDate            DateTime @db.Date
  fiscalYearLabel   String
  fyOpeningWdvMinor Int
  chargeableDays    Int
  rateBp            Int
  openingWdvMinor   Int
  amountMinor       Int
  closingWdvMinor   Int
  lifeEnd           Boolean  @default(false)

  run   DepreciationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  asset FixedAsset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([tenantId, assetId, toDate])
  @@index([tenantId, runId])
}

// ---------------------------------------------------------------------------
// Expense approval (phase 6). An expense awaiting approval lives here, never in
// SchoolExpense, so it cannot reach the ledgers, the expense dashboards or the
// nightly posting job. Final approval creates the SchoolExpense and its journal
// entry in the same transaction. Heads, ledgers, expenses and users are
// referenced by id (no foreign keys to existing tables).
// ---------------------------------------------------------------------------

enum ExpenseApprovalStatus {
  /// Stage 1: the creator is still preparing it.
  DRAFT
  /// Stage 2: submitted, awaiting validation / audit.
  SUBMITTED
  /// Stage 3: awaiting approver L1 (department head).
  PENDING_L1
  /// Stage 4: awaiting approver L2 (finance officer).
  PENDING_L2
  /// Stage 5: awaiting the final approver (principal).
  PENDING_FINAL
  /// Sent back to the creator for correction; resubmitting starts again at stage 2.
  RETURNED
  REJECTED
  WITHDRAWN
  /// Final approval and posting succeeded together; expenseId is set.
  POSTED
  REVERSED
}

model ExpenseApprovalRequest {
  id             String                @id @default(cuid())
  tenantId       String
  /// EAR-2627-00001
  number         String
  title          String
  headId         String
  amountMinor    Int
  expenseDate    DateTime              @db.Date
  paymentMode    ExpensePaymentMode    @default(CASH)
  vendor         String?
  referenceNo    String?
  notes          String?
  cashAccountId  String?
  receiptKey     String?
  receiptName    String?
  receiptMime    String?
  status         ExpenseApprovalStatus @default(DRAFT)
  /// Submission round; a return for correction starts a new one and clears earlier sign-offs.
  cycle          Int                   @default(1)
  createdById    String?
  createdByLabel String?
  submittedAt    DateTime?
  /// The SchoolExpense created at final approval.
  expenseId      String?
  postedAt       DateTime?
  reversedAt     DateTime?
  idempotencyKey String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  steps ExpenseApprovalStep[]

  @@unique([tenantId, number])
  @@unique([tenantId, expenseId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, expenseDate])
  @@index([tenantId, createdById])
}

/// One row per transition: who moved the request from which status to which, and why.
model ExpenseApprovalStep {
  id         String                @id @default(cuid())
  tenantId   String
  requestId  String
  cycle      Int
  /// SUBMIT, VALIDATE, APPROVE_L1, APPROVE_L2, APPROVE_FINAL, RETURN, REJECT, WITHDRAW, EDIT, REVERSE
  action     String
  fromStatus ExpenseApprovalStatus
  toStatus   ExpenseApprovalStatus
  actorId    String?
  actorLabel String?
  remarks    String?
  createdAt  DateTime              @default(now())

  request ExpenseApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([tenantId, requestId, createdAt])
  @@index([tenantId, actorId])
}

// ---------------------------------------------------------------------------
// Analytics summaries (phase 7). Derived data only: every row can be rebuilt
// from JournalEntry / JournalLine, so deleting this table loses nothing.
// ---------------------------------------------------------------------------

/// Journal line totals per calendar month, ledger account and entry source.
model LedgerMonthSummary {
  tenantId    String
  /// First day of the month of JournalEntry.date.
  month       DateTime          @db.Date
  accountId   String
  sourceType  JournalSourceType
  debitMinor  BigInt            @default(0)
  creditMinor BigInt            @default(0)
  lineCount   Int               @default(0)

  @@id([tenantId, month, accountId, sourceType])
  @@index([tenantId, accountId, month])
}

/// How far LedgerMonthSummary has caught up with the journal, per school.
model LedgerSummaryState {
  id              String    @id @default(cuid())
  tenantId        String    @unique
  /// Newest JournalEntry.createdAt folded into the summary.
  watermark       DateTime?
  /// Journal entries the summary covered; a mismatch forces a full rebuild.
  entryCount      Int       @default(0)
  refreshedAt     DateTime
  rebuiltAt       DateTime?
  monthsRefreshed Int       @default(0)
  durationMs      Int       @default(0)
}

// ===========================================================================
// DAILY OPERATIONS: SUBSTITUTIONS, GATE PASSES, PARENT WHATSAPP ASSISTANT
// ===========================================================================

enum SubstitutionStatus {
  OPEN
  ASSIGNED
  CANCELLED
}

/// Cover for one lesson on one date while its teacher is away. OPEN rows are
/// lessons still needing someone; ASSIGNED rows name the substitute.
model Substitution {
  id              String             @id @default(cuid())
  tenantId        String
  onDate          DateTime           @db.Date
  sectionId       String
  periodId        String
  classSubjectId  String?
  absentTeacherId String
  substituteId    String?
  status          SubstitutionStatus @default(OPEN)
  /// LEAVE | ABSENT | MANUAL
  reason          String?
  note            String?
  notifiedAt      DateTime?
  assignedById    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  section       Section         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  period        TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  classSubject  ClassSubject?   @relation(fields: [classSubjectId], references: [id], onDelete: SetNull)
  absentTeacher Staff           @relation("SubstitutionAbsent", fields: [absentTeacherId], references: [id], onDelete: Cascade)
  substitute    Staff?          @relation("SubstitutionCover", fields: [substituteId], references: [id], onDelete: SetNull)

  @@unique([tenantId, onDate, sectionId, periodId])
  @@index([tenantId, onDate])
  @@index([tenantId, substituteId, onDate])
}

enum GatePassStatus {
  AWAITING_OTP
  APPROVED
  EXITED
  CANCELLED
}

/// A student leaving before the end of the day. The desk raises it, the
/// collector is verified (guardian OTP or in person), the gate scans it out
/// and the parents are told.
model GatePass {
  id               String         @id @default(cuid())
  tenantId         String
  passNumber       String
  /// Unguessable value the QR code carries.
  token            String         @unique
  studentId        String
  reason           String
  pickupName       String
  pickupRelation   String?
  pickupPhone      String?
  guardianId       String?
  /// OTP | IN_PERSON
  verification     String?
  otpHash          String?
  otpExpiresAt     DateTime?
  otpAttempts      Int            @default(0)
  otpSentTo        String?
  status           GatePassStatus @default(AWAITING_OTP)
  issuedById       String?
  issuedByLabel    String?
  approvedAt       DateTime?
  exitedAt         DateTime?
  exitedByLabel    String?
  parentNotifiedAt DateTime?
  cancelReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Parent? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  @@unique([tenantId, passNumber])
  @@index([tenantId, createdAt])
  @@index([tenantId, studentId])
}

enum ParentQueryStatus {
  OPEN
  RESOLVED
}

/// A question a parent sent to the WhatsApp assistant that needs a person.
model ParentQuery {
  id          String            @id @default(cuid())
  tenantId    String
  parentId    String?
  studentId   String?
  phone       String
  senderName  String?
  message     String
  status      ParentQueryStatus @default(OPEN)
  reply       String?
  repliedAt   DateTime?
  repliedById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  parent  Parent?  @relation(fields: [parentId], references: [id], onDelete: SetNull)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

/// Where a phone number is in its WhatsApp assistant conversation. Keyed by
/// the last ten digits because one shared business number serves every
/// school; the school and child it has picked are remembered here.
model WhatsAppBotSession {
  phone         String   @id
  schoolTenant  String?
  studentId     String?
  /// What the next free-text message means: null = a menu choice,
  /// SCHOOL / CHILD = picking from a list, QUERY = a message for the office.
  awaiting      String?
  lastInboundAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===========================================================================
// CCTV (live view through a relay on the school's own PC)
// ===========================================================================

/// One per school. Video never passes through MyCampusView: the relay on the
/// school PC serves it and only checks the short-lived tokens we sign. The
/// recorder password is never stored here.
model CctvSite {
  id                  String    @id @default(cuid())
  tenantId            String    @unique
  name                String    @default("School CCTV")
  enabled             Boolean   @default(false)
  /// Public https address of the relay (the Cloudflare tunnel), no trailing slash.
  streamBaseUrl       String?
  nvrHost             String?
  nvrPort             Int       @default(554)
  nvrUsername         String?
  parentAccessEnabled Boolean   @default(false)
  /// "HH:mm" in India time.
  parentStart         String    @default("08:00")
  parentEnd           String    @default("14:00")
  /// 1 = Monday … 7 = Sunday.
  parentDays          Int[]     @default([1, 2, 3, 4, 5, 6])
  /// SHA-256 of the relay app's connection key; the key itself is shown once.
  relayKeyHash        String?
  relayKeyHint        String?
  relayKeyCreatedAt   DateTime?
  relayLastSeenAt     DateTime?
  relayAppVersion     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cameras CctvCamera[]
}

enum CctvZone {
  GENERAL
  GATE
  CLASSROOM
}

model CctvCamera {
  id        String   @id @default(cuid())
  tenantId  String
  siteId    String
  name      String
  /// Recorder channel number (1-based).
  channel   Int
  zone      CctvZone @default(GENERAL)
  sectionId String?
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site    CctvSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([tenantId, channel])
  @@index([tenantId, zone])
  @@index([tenantId, sectionId])
}
