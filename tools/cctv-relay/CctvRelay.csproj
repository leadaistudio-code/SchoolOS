<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MyCampusView CCTV Relay. Targets .NET Framework 4.8, which ships with
    Windows 10 and 11, so the school PC needs nothing installed and the
    output is a single exe (MediaMTX is embedded as a resource).
    Build with build.ps1, which verifies the MediaMTX download first.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MyCampusView-CCTV-Relay</AssemblyName>
    <RootNamespace>MyCampusView.CctvRelay</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Company>MyCampusView</Company>
    <Product>MyCampusView CCTV Relay</Product>
    <Description>MyCampusView CCTV Relay</Description>
    <Copyright>© MyCampusView</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="vendor\mediamtx.zip" LogicalName="mediamtx.zip" />
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
    <EmbeddedResource Include="assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
