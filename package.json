{
  "name": "schoolos",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup:school": "tsx scripts/create-school.ts",
    "map:domain": "tsx scripts/map-domain.ts",
    "assistant:enable": "tsx scripts/enable-assistant.ts",
    "rbac:sync": "tsx scripts/sync-permissions.ts",
    "assistant:doctor": "tsx scripts/assistant-doctor.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:content": "tsx scripts/demo-content.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@prisma/client": "^6.2.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.469.0",
    "next": "^15.5.23",
    "nodemailer": "^7.0.13",
    "openai": "^7.4.0",
    "prisma": "^6.2.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.5.23",
    "vitest": "^2.1.8"
  }
}
