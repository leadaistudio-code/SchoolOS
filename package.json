{
  "name": "mycampusview",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "setup:school": "tsx scripts/create-school.ts",
    "reset:password": "tsx scripts/reset-user-password.ts",
    "exam:defaults": "tsx scripts/ensure-exam-defaults.ts",
    "map:domain": "tsx scripts/map-domain.ts",
    "assistant:enable": "tsx scripts/enable-assistant.ts",
    "rbac:sync": "tsx scripts/sync-permissions.ts",
    "assistant:doctor": "tsx scripts/assistant-doctor.ts",
    "mail:doctor": "tsx scripts/mail-doctor.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:content": "tsx scripts/demo-content.ts",
    "load:smoke": "tsx scripts/run-k6.ts smoke",
    "load:soak": "tsx scripts/run-k6.ts soak",
    "health:watch": "tsx scripts/health-watch.ts",
    "db:backup": "tsx scripts/run-backup.ts",
    "db:restore-drill": "tsx scripts/restore-drill-help.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
