    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "three": "^0.185.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
