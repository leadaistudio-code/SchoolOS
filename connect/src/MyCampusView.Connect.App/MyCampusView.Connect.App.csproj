<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One self-contained exe that is the setup wizard, the manager and the
    Windows service itself (run with "service"). The school PC needs no .NET,
    no PowerShell and no config editing. Build with scripts/build-installer.ps1.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MyCampusViewConnect</AssemblyName>
    <RootNamespace>MyCampusView.Connect.App</RootNamespace>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <Company>MyCampusView</Company>
    <Product>MyCampusView Connect</Product>
    <Description>MyCampusView Connect - biometric attendance for MyCampusView</Description>
    <Copyright>© MyCampusView</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The worker is referenced as a library; this exe is the only one shipped. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCampusView.Connect\MyCampusView.Connect.csproj" />
    <ProjectReference Include="..\MyCampusView.Connect.Core\MyCampusView.Connect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\logo.png" LogicalName="logo.png" />
  </ItemGroup>

</Project>
