<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyCampusView.Connect</RootNamespace>
    <AssemblyName>MyCampusView.Connect</AssemblyName>
    <Version>1.0.0</Version>
    <Description>MyCampusView Connect Windows biometric gateway worker</Description>
    <UserSecretsId>mycampusview-connect-worker</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCampusView.Connect.Core\MyCampusView.Connect.Core.csproj" />
  </ItemGroup>

</Project>
